+static int slim_tx_mux_get(struct snd_kcontrol *kcontrol,
+			   struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component =
+		snd_soc_dapm_kcontrol_component(kcontrol);
+	struct wcd9320_priv *wcd = dev_get_drvdata(component->dev);
+
+	ucontrol->value.enumerated.item[0] = wcd->tx_port_value;
+	return 0;
+}
+
+/*
+ * Subscribe one slave TX port to the capture DAI, the mirror of
+ * slim_rx_mux_put(). Only AIF1_CAP exists for now - this is the capture path
+ * the port-engine bisection needs, not the full TX complement.
+ */
+static int slim_tx_mux_put(struct snd_kcontrol *kcontrol,
+			   struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_dapm_widget *widget =
+		snd_soc_dapm_kcontrol_widget(kcontrol);
+	struct snd_soc_component *component =
+		snd_soc_dapm_kcontrol_component(kcontrol);
+	struct wcd9320_priv *wcd = dev_get_drvdata(component->dev);
+	struct soc_enum *e = (struct soc_enum *)kcontrol->private_value;
+	struct snd_soc_dapm_update *update = NULL;
+	u32 port_id = widget->shift;
+
+	if (port_id >= WCD9320_TX_MAX)
+		return -EINVAL;
+
+	wcd->tx_port_value = ucontrol->value.enumerated.item[0];
+
+	/*
+	 * Unlink first, unconditionally. Setting this control twice used to
+	 * list_add_tail() a node that was already on the list, which splices
+	 * the list into a cycle - and then wcd9320_get_channel_map() walks it
+	 * forever, writing past the end of the caller's tx_slot[] array. That
+	 * is a stack smash in msm_snd_hw_params(), not a warning: the trace
+	 * came back with the return address overwritten by 0x80, which is
+	 * BASE_CH_NUM, the value being written.
+	 *
+	 * The RX mux guards this with wcd_slim_rx_vport_validation(); doing it
+	 * by making the subscribe idempotent is simpler and also covers the
+	 * node having been left on some other DAI's list.
+	 */
+	if (!list_empty(&wcd->slim_data->tx_chs[port_id].list))
+		list_del_init(&wcd->slim_data->tx_chs[port_id].list);
+
+	if (wcd->tx_port_value)
+		list_add_tail(&wcd->slim_data->tx_chs[port_id].list,
+			      &wcd->dai[AIF1_CAP].wcd_slim_ch_list);
+
+	snd_soc_dapm_mux_update_power(widget->dapm, kcontrol,
+				      wcd->tx_port_value, e, update);
+	return 0;
+}
+
+static const struct soc_enum slim_tx_mux_enum =
+	SOC_ENUM_SINGLE_EXT(ARRAY_SIZE(slim_tx_mux_text), slim_tx_mux_text);
