+/*
+ * Capture mirror of wcd9320_codec_enable_slimrx(). Same ordering, and for the
+ * same reason: the channel is activated from POST_PMU, once the port
+ * interrupts and the channel mask are set up, rather than from the DAI's
+ * prepare callback.
+ */
+static int wcd9320_codec_enable_slimtx(struct snd_soc_dapm_widget *w,
+				       struct snd_kcontrol *kcontrol,
+				       int event)
+{
+	struct snd_soc_component *component = snd_soc_dapm_to_component(w->dapm);
+	struct wcd9320_priv *wcd = dev_get_drvdata(component->dev);
+	struct wcd_slim_codec_dai_data *dai;
+
+	if (wcd->intf_type != WCD_INTERFACE_TYPE_SLIMBUS)
+		return 0;
+
+	dai = &wcd->dai[w->shift];
+
+	switch (event) {
+	case SND_SOC_DAPM_POST_PMU:
+		wcd9320_codec_enable_int_port(dai, component);
+		(void) wcd9320_codec_enable_slim_chmask(dai, true);
+		wcd_slim_stream_enable(wcd->slim_data, dai);
+		break;
+	case SND_SOC_DAPM_POST_PMD:
+		wcd9320_codec_enable_slim_chmask(dai, false);
+		slim_stream_unprepare(dai->sruntime);
+		slim_stream_disable(dai->sruntime);
+		break;
+	}
+	return 0;
+}
