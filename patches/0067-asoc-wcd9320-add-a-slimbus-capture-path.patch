+/*
+ * The capture equivalent, kept as its own function rather than a direction
+ * flag on the one above. The RX path is the only thing on this codec that
+ * currently works end to end as far as the bus, and this exists to probe
+ * whether the CDC-to-port interface moves data in the other direction; it is
+ * not worth risking the working path to save the duplication.
+ *
+ * Three things differ from RX. Slave TX ports are numbered from 0, so the
+ * port mask is not offset by 0x10. The channel bitmap is 16 bits wide and
+ * splits across two registers once the port index reaches 8. And the stream
+ * has to be declared as capture, which the RX path never sets - it leaves
+ * direction at 0, which is SNDRV_PCM_STREAM_PLAYBACK.
+ */
+static int wcd_slim_tx_stream_prepare(struct wcd9320_priv *wcd,
+				      struct wcd_slim_codec_dai_data *dai_data)
+{
+	struct slim_stream_config *cfg = &dai_data->sconfig;
+	struct list_head *ch_list = &dai_data->wcd_slim_ch_list;
+	struct wcd_slim_data *wcd_sd = wcd->slim_data;
+	struct wcd_slim_ch *tx;
+	u16 payload = 0;
+	u16 codec_port;
+	int ret, i = 0;
+
+	cfg->ch_count = 0;
+	cfg->port_mask = 0;
+
+	list_for_each_entry(tx, ch_list, list) {
+		payload |= 1 << tx->shift;
+		cfg->port_mask |= 1 << tx->shift;
+		cfg->ch_count++;
+	}
+
+	if (!cfg->ch_count) {
+		dev_err(wcd->dev, "no tx channels subscribed\n");
+		return -EINVAL;
+	}
+
+	cfg->chs = kcalloc(cfg->ch_count, sizeof(unsigned int), GFP_KERNEL);
+	if (!cfg->chs)
+		return -ENOMEM;
+
+	cfg->rate = dai_data->rate;
+	cfg->bps = dai_data->bit_width;
+	cfg->direction = SNDRV_PCM_STREAM_CAPTURE;
+
+	list_for_each_entry(tx, ch_list, list) {
+		codec_port = tx->port;
+		cfg->chs[i++] = tx->ch_num;
+
+		ret = regmap_write(wcd_sd->if_regmap,
+				   SB_PGD_TX_PORT_MULTI_CHANNEL_0(codec_port),
+				   payload & 0x00ff);
+		if (ret < 0) {
+			dev_err(wcd->dev, "tx chmap lo write failed port %d: %d\n",
+				codec_port, ret);
+			goto err;
+		}
+
+		if (codec_port >= 8) {
+			ret = regmap_write(wcd_sd->if_regmap,
+					   SB_PGD_TX_PORT_MULTI_CHANNEL_1(codec_port),
+					   (payload & 0xff00) >> 8);
+			if (ret < 0) {
+				dev_err(wcd->dev, "tx chmap hi write failed port %d: %d\n",
+					codec_port, ret);
+				goto err;
+			}
+		}
+
+		ret = regmap_write(wcd_sd->if_regmap,
+				   SB_PGD_PORT_CFG_BYTE_ADDR(
+					   wcd_sd->port_tx_cfg_reg_base, codec_port),
+				   WATER_MARK_VAL);
+		if (ret < 0)
+			dev_err(wcd->dev, "tx watermark failed port %d: %d\n",
+				codec_port, ret);
+	}
+
+	dai_data->sruntime = slim_stream_allocate(wcd->slim, "WCD9320-SLIM-TX");
+	if (!dai_data->sruntime) {
+		ret = -ENOMEM;
+		goto err;
+	}
+
+	slim_stream_prepare(dai_data->sruntime, cfg);
+	return 0;
+
+err:
+	kfree(cfg->chs);
+	cfg->chs = NULL;
+	return ret;
+}
