 extern void secondary_startup_arm(void);
 
 #ifdef CONFIG_HOTPLUG_CPU
+static DEFINE_PER_CPU(struct spm_driver_data *, qcom_cpu_spm);
+
+/* The SPM that owns this CPU's power rail, as the SPM cpuidle driver finds it */
+static struct spm_driver_data *qcom_cpu_spm_find(unsigned int cpu)
+{
+	struct device_node *cpu_node, *saw_node;
+	struct platform_device *pdev;
+	struct spm_driver_data *drv;
+
+	cpu_node = of_get_cpu_node(cpu, NULL);
+	if (!cpu_node)
+		return NULL;
+
+	saw_node = of_parse_phandle(cpu_node, "qcom,saw", 0);
+	of_node_put(cpu_node);
+	if (!saw_node)
+		return NULL;
+
+	pdev = of_find_device_by_node(saw_node);
+	of_node_put(saw_node);
+	if (!pdev)
+		return NULL;
+
+	drv = dev_get_drvdata(&pdev->dev);
+	put_device(&pdev->dev);
+
+	return drv;
+}
+
+/*
+ * Runs on the outgoing core, in process context, as it starts going down:
+ * find what qcom_cpu_die() needs to power it off. Not at boot, because the
+ * SPM and SCM drivers probe in their own time (an init-time lookup found
+ * neither), and not in qcom_cpu_die(), which runs on a core the hotplug core
+ * already counts as gone. Without both, the core parks in WFI.
+ *
+ * A collapsed core comes back through the warm boot address, into
+ * cpu_suspend(). The SPM cpuidle driver registers that address too, but
+ * hotplug must not depend on cpuidle being built or probed, so register it
+ * here as well.
+ */
+static int qcom_cpu_offline_prepare(unsigned int cpu)
+{
+	static bool warm_boot_set;
+
+	if (per_cpu(qcom_cpu_spm, cpu))
+		return 0;
+
+	if (!warm_boot_set) {
+		if (!qcom_scm_is_available() ||
+		    qcom_scm_set_warm_boot_addr(cpu_resume_arm))
+			return 0;
+		warm_boot_set = true;
+	}
+
+	per_cpu(qcom_cpu_spm, cpu) = qcom_cpu_spm_find(cpu);
+
+	return 0;
+}
+
+static bool qcom_smp_in_use;
+
+static int __init qcom_cpu_hotplug_init(void)
+{
+	int ret;
+
+	if (!qcom_smp_in_use)
+		return 0;
+
+	ret = cpuhp_setup_state_nocalls(CPUHP_AP_ONLINE_DYN, "arm/qcom:offline",
+					NULL, qcom_cpu_offline_prepare);
+	return ret < 0 ? ret : 0;
+}
+late_initcall(qcom_cpu_hotplug_init);
+
+static int qcom_pm_collapse(unsigned long unused)
+{
+	qcom_scm_cpu_power_down(QCOM_SCM_CPU_PWR_DOWN_L2_ON);
+
+	/*
+	 * Only reached if an interrupt was pending and we did not power down
+	 * as a result.
+	 */
+	return -1;
+}
+
 static void qcom_cpu_die(unsigned int cpu)
 {
-	wfi();
+	struct spm_driver_data *drv = per_cpu(qcom_cpu_spm, cpu);
+
+	/*
+	 * A plain WFI here can never be woken. __cpu_disable() has already run
+	 * ipi_teardown(), which disables every one of this CPU's per-CPU
+	 * interrupts - and IPI_WAKEUP is the first entry of ipi_msg_type - so
+	 * the wakeup IPI that qcom_boot_secondary() sends cannot be delivered
+	 * to us and arch_cpu_idle_dead()'s fallthrough is unreachable.
+	 *
+	 * Power the core off instead, with the same SPM mode and SCM call the
+	 * SPM cpuidle driver uses for an ordinary idle collapse. Standalone
+	 * power collapse leaves the L2 up, which is what we want: the other
+	 * cores are still running out of it.
+	 *
+	 * Going properly off is also what makes bringing the core back legal.
+	 * kpssv2_release_secondary() is a cold-boot power-up sequence and ends
+	 * by asserting CLAMP and COREPOR_RST; run against a core that is still
+	 * powered and clocked it hangs the fabric and the SoC is reset.
+	 */
+	/*
+	 * Say which of the two it is going to be. Without this the two cases
+	 * are indistinguishable from outside: a failed lookup falls back to the
+	 * old WFI park, which fails an online exactly the way a working
+	 * collapse does until the release sequence is re-run as well.
+	 */
+	if (drv)
+		pr_info("CPU%u: going down by SPM power collapse\n", cpu);
+	else
+		pr_warn("CPU%u: no SPM found, parking in WFI instead\n", cpu);
+
+	for (;;) {
+		if (drv) {
+			spm_set_low_power_mode(drv, PM_SLEEP_MODE_SPC);
+			cpu_suspend(0, qcom_pm_collapse);
+			/*
+			 * Still here, so an interrupt beat the collapse and the
+			 * SPM brought us back through the warm boot address.
+			 * Put the SPM back to standby - a mode left armed turns
+			 * an unrelated WFI into a power collapse - and retry.
+			 */
+			spm_set_low_power_mode(drv, PM_SLEEP_MODE_STBY);
+		} else {
+			wfi();
+		}
+	}
 }
 #endif
 
