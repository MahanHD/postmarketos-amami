From: MahanHD <mahanheidari2003@gmail.com>
Subject: [PATCH] iommu/arm-smmu-qcom: write msm8974's BFB settings on every reset

Downstream's msm_iommu-v1 writes a table of implementation defined
registers (qcom,iommu-bfb-regs and -data) each time it programs an SMMU,
and kgsl detaches and reattaches the GPU's SMMU in every stop and start,
so on stock the GPU SMMU gets the table again after every power collapse.
TrustZone does not own this SMMU, so nothing else writes it; with
arm-smmu the GPU SMMU has never had these values.

Read the table from the device tree once, in the msm8974 cfg_probe hook,
rejecting one whose lengths differ or whose registers fall outside the
global register space, and write it from a reset hook, which arm-smmu
calls at probe and on every runtime resume. Give amami's GPU SMMU the
twelve values from the kgsl_iommu node of Sony's stock device tree; they
belong to the board, since LineageOS's tree has a different table for the
same SoC.

---
--- a/arch/arm/boot/dts/qcom/qcom-msm8974-sony-xperia-rhine-amami.dts	2026-10-15 10:20:56.504343261 +0400
+++ b/arch/arm/boot/dts/qcom/qcom-msm8974-sony-xperia-rhine-amami.dts	2026-10-15 10:21:22.385309518 +0400
@@ -51,6 +51,18 @@
 	};
 };
 
+/*
+ * Implementation defined settings for the GPU's SMMU, verbatim from the
+ * kgsl_iommu node of Sony's stock device tree (LineageOS has a different
+ * table for the same SoC, so they stay with this board).
+ */
+&gpu_smmu {
+	qcom,iommu-bfb-regs = <0x204c 0x2050 0x2514 0x2540 0x256c 0x20ac
+			       0x215c 0x220c 0x2314 0x2394 0x2414 0x2008>;
+	qcom,iommu-bfb-data = <0x3 0x0 0x4 0x10 0x0 0x0
+			       0x0 0x20 0x0 0x1 0x81 0x0>;
+};
+
 &gpu {
 	status = "okay";
 };
--- a/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c	2026-10-15 10:20:56.503343259 +0400
+++ b/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c	2026-10-15 10:21:22.384883910 +0400
@@ -693,6 +693,45 @@
 }
 
 /*
+ * Downstream's msm_iommu-v1 writes a table of implementation defined registers
+ * (qcom,iommu-bfb-regs and -data) every time it programs the SMMU, and kgsl
+ * detaches and reattaches the GPU's SMMU on every power cycle, so the table is
+ * rewritten after every power collapse. TrustZone does not own these SMMUs, so
+ * nothing else writes it. Read and check the table once here; the reset hook,
+ * which runs at probe and on every runtime resume, writes it.
+ */
+static int msm8974_smmu_bfb_probe(struct arm_smmu_device *smmu)
+{
+	struct qcom_smmu *qsmmu = to_qcom_smmu(smmu);
+	struct device_node *np = smmu->dev->of_node;
+	u32 global_size = smmu->numpage << smmu->pgshift;
+	int n, i;
+
+	n = of_property_count_u32_elems(np, "qcom,iommu-bfb-regs");
+	if (n <= 0)
+		return 0;
+	if (of_property_count_u32_elems(np, "qcom,iommu-bfb-data") != n)
+		return dev_err_probe(smmu->dev, -EINVAL,
+				     "qcom,iommu-bfb-regs and -data differ in length\n");
+
+	qsmmu->bfb = devm_kcalloc(smmu->dev, 2 * n, sizeof(*qsmmu->bfb), GFP_KERNEL);
+	if (!qsmmu->bfb)
+		return -ENOMEM;
+	of_property_read_u32_array(np, "qcom,iommu-bfb-regs", qsmmu->bfb, n);
+	of_property_read_u32_array(np, "qcom,iommu-bfb-data", qsmmu->bfb + n, n);
+
+	for (i = 0; i < n; i++) {
+		if (qsmmu->bfb[i] % 4 || qsmmu->bfb[i] >= global_size)
+			return dev_err_probe(smmu->dev, -EINVAL,
+					     "bfb register 0x%x is outside the global space\n",
+					     qsmmu->bfb[i]);
+	}
+	qsmmu->bfb_count = n;
+
+	return 0;
+}
+
+/*
  * msm8974's IDR1.NUMPAGENDXB reports four pages, which would put context bank n at
  * base + 0x4000 + n * 0x1000. Downstream addresses the banks at 0xfdb18000 on a
  * base of 0xfdb10000, i.e. base + 0x8000, so the register under-reports. Probe both
@@ -722,7 +761,7 @@
 	dev_info(smmu->dev, "context banks forced to base + 0x%x\n",
 		 smmu->numpage << smmu->pgshift);
 
-	return 0;
+	return msm8974_smmu_bfb_probe(smmu);
 }
 
 /*
@@ -746,10 +785,23 @@
 			  reg & ~ARM_SMMU_SCTLR_AFE);
 }
 
+static int msm8974_smmu_reset(struct arm_smmu_device *smmu)
+{
+	struct qcom_smmu *qsmmu = to_qcom_smmu(smmu);
+	int i;
+
+	for (i = 0; i < qsmmu->bfb_count; i++)
+		writel_relaxed(qsmmu->bfb[qsmmu->bfb_count + i],
+			       smmu->base + qsmmu->bfb[i]);
+
+	return 0;
+}
+
 static const struct arm_smmu_impl msm8974_smmu_impl = {
 	.init_context = qcom_smmu_init_context,
 	.cfg_probe = msm8974_smmu_cfg_probe,
 	.def_domain_type = qcom_smmu_def_domain_type,
+	.reset = msm8974_smmu_reset,
 	.write_s2cr = msm8974_smmu_write_s2cr,
 	.write_sctlr = msm8974_smmu_write_sctlr,
 	.tlb_sync = qcom_smmu_tlb_sync,
--- a/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.h	2026-10-15 10:20:56.504343261 +0400
+++ b/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.h	2026-10-15 10:21:11.426009885 +0400
@@ -12,6 +12,9 @@
 	bool bypass_quirk;
 	u8 bypass_cbndx;
 	u32 stall_enabled;
+	/* msm8974: implementation defined registers, then their values */
+	u32 *bfb;
+	int bfb_count;
 };
 
 enum qcom_smmu_impl_reg_offset {
