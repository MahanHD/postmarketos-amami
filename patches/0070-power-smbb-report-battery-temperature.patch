 /*
+ * The battery thermistor, looked up lazily for the same reasons as vbat above
+ * and offered only on boards that wire a "batt-therm" io-channel.
+ *
+ * Two unit traps. The IIO channel is processed in milli-degrees while
+ * POWER_SUPPLY_PROP_TEMP is in tenths of a degree, hence the /100. And as
+ * above, a successful iio_read_channel_processed() returns IIO_VAL_INT rather
+ * than 0, so only a negative is an error.
+ *
+ * This is not the comparator the charger itself acts on: the SMBB decides
+ * hot/cold from its own BTC thresholds and that is what HEALTH reports. This is
+ * the measured value, and it is only as good as the VADC's scaling for the
+ * thermistor actually fitted - on amami that is mainline's generic 100k curve
+ * rather than the battery's own table, so treat it as indicative.
+ */
+static int smbb_battery_temp(struct smbb_charger *chg, int *decidegc)
+{
+	int rc, millidegc;
+
+	if (!chg->btherm) {
+		struct iio_channel *ch;
+
+		mutex_lock(&chg->btherm_lock);
+		/* another reader may have got there while we waited */
+		if (!chg->btherm) {
+			ch = devm_iio_channel_get(chg->dev, "batt-therm");
+			if (!IS_ERR(ch))
+				chg->btherm = ch;
+		}
+		mutex_unlock(&chg->btherm_lock);
+
+		if (!chg->btherm)
+			return -ENODATA;
+	}
+
+	rc = iio_read_channel_processed(chg->btherm, &millidegc);
+	if (rc < 0)
+		return rc;
+
+	*decidegc = millidegc / 100;
+
+	return 0;
+}
+
