+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xea, 0xff);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xff, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xc2, 0x03);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x3b, 0x03, 0x02, 0x03, 0x08, 0x04);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xba, 0x03);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x11);
+	mipi_dsi_msleep(dsi_ctx, 50);
+}
+static const struct amami_variant amami_variants[] = {
+	{ "jdi novatek 720p",         0x57,          amami_init_jdi     },
+	{ "auo novatek 720p",         0x00,          amami_init_auo     },
+	{ "auo novatek 720p new id",  0x43,          amami_init_auo_new },
+	{ "default novatek 720p",     AMAMI_ID_ANY,  amami_init_default },
+};
+
+static const struct amami_variant *amami_detect(struct amami_novatek *ctx)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct device *dev = &dsi->dev;
+	const struct amami_variant *fallback = NULL;
+	u8 id[4] = { };
+	int ret, i;
+
+	/* the fallback entry is the one with the wildcard id */
+	for (i = 0; i < ARRAY_SIZE(amami_variants); i++)
+		if (amami_variants[i].id == AMAMI_ID_ANY)
+			fallback = &amami_variants[i];
+
+	ret = mipi_dsi_dcs_read(dsi, AMAMI_DCS_READ_ID, id, sizeof(id));
+	if (ret < 0) {
+		dev_warn(dev, "panel ID read failed (%d), using %s\n",
+			 ret, fallback->name);
+		return fallback;
+	}
+
+	dev_info(dev, "panel ID read (%d bytes): %*ph\n", ret, ret, id);
+
+	if (ret >= 4) {
+		for (i = 0; i < ARRAY_SIZE(amami_variants); i++) {
+			if (amami_variants[i].id == AMAMI_ID_ANY)
+				continue;
+			if (amami_variants[i].id == id[3]) {
+				dev_info(dev, "matched panel: %s\n",
+					 amami_variants[i].name);
+				return &amami_variants[i];
+			}
+		}
+	}
+
+	dev_info(dev, "no panel ID match, using %s\n", fallback->name);
+	return fallback;
+}
+
+static int amami_novatek_on(struct amami_novatek *ctx)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	if (!ctx->variant)
+		ctx->variant = amami_detect(ctx);
+
+	ctx->variant->init(&dsi_ctx);
+
+	/*
+	 * The init sequences end with DCS exit_sleep_mode. Do NOT switch the
+	 * display on here: DRM calls prepare() before the DSI host starts
+	 * sending video, and this Novatek controller would then latch its
+	 * (uninitialised) internal GRAM instead of the incoming stream.
+	 * set_display_on happens in enable(), once video is running.
+	 */
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	if (dsi_ctx.accum_err)
+		dev_err(&dsi->dev, "panel init failed: %d\n", dsi_ctx.accum_err);
+
+	return dsi_ctx.accum_err;
+}
+
+static int amami_novatek_off(struct amami_novatek *ctx)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+
+	/* low-power mode: see the note in amami_novatek_disable() */
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_ENTER_SLEEP_MODE);
+	/* DCS requires >=120ms after sleep-in; leave extra margin */
+	mipi_dsi_msleep(&dsi_ctx, 150);
+
+	return dsi_ctx.accum_err;
+}
+
+static int amami_novatek_prepare(struct drm_panel *panel)
+{
+	struct amami_novatek *ctx = to_amami_novatek(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	gpiod_set_value_cansleep(ctx->enable_gpio, 1);
+	msleep(50);
+
+	amami_novatek_reset(ctx);
+
+	ret = amami_novatek_on(ctx);
+	if (ret < 0) {
+		dev_err(dev, "Failed to initialize panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int amami_novatek_enable(struct drm_panel *panel)
+{
+	struct amami_novatek *ctx = to_amami_novatek(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	/* video is streaming by now, so the panel latches it rather than GRAM */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_DISPLAY_ON);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+
+	return dsi_ctx.accum_err;
+}
+
+static int amami_novatek_disable(struct drm_panel *panel)
+{
+	struct amami_novatek *ctx = to_amami_novatek(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	/*
+	 * Send the shutdown commands in low-power mode. In HS mode the msm DSI
+	 * host waits for a completed video frame before each transfer, which
+	 * times out (-110) while the stream is being torn down and stalls every
+	 * modeset/VT switch for 10s a piece.
+	 */
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_DISPLAY_OFF);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+
+	return dsi_ctx.accum_err;
+}
+
+static int amami_novatek_unprepare(struct drm_panel *panel)
+{
+	struct amami_novatek *ctx = to_amami_novatek(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = amami_novatek_off(ctx);
+	if (ret < 0)
+		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	gpiod_set_value_cansleep(ctx->enable_gpio, 0);
+
+	return 0;
+}
+
+static const struct drm_display_mode amami_novatek_mode = {
+	/* 720x1280@60, porches taken from the downstream panel node */
+	.clock = (720 + 136 + 4 + 4) * (1280 + 94 + 1 + 1) * 60 / 1000,
+	.hdisplay = 720,
+	.hsync_start = 720 + 136,
+	.hsync_end = 720 + 136 + 4,
+	.htotal = 720 + 136 + 4 + 4,
+	.vdisplay = 1280,
+	.vsync_start = 1280 + 94,
+	.vsync_end = 1280 + 94 + 1,
+	.vtotal = 1280 + 94 + 1 + 1,
+	.width_mm = 54,
+	.height_mm = 95,
+};
+
+static int amami_novatek_get_modes(struct drm_panel *panel,
+				   struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &amami_novatek_mode);
+	if (!mode)
+		return -ENOMEM;
+
+	drm_mode_set_name(mode);
+
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	connector->display_info.width_mm = mode->width_mm;
+	connector->display_info.height_mm = mode->height_mm;
+	drm_mode_probed_add(connector, mode);
+
+	return 1;
+}
+
+static const struct drm_panel_funcs amami_novatek_panel_funcs = {
+	.prepare = amami_novatek_prepare,
+	.enable = amami_novatek_enable,
+	.disable = amami_novatek_disable,
+	.unprepare = amami_novatek_unprepare,
+	.get_modes = amami_novatek_get_modes,
+};
+
+static int amami_novatek_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct amami_novatek *ctx;
+	int ret;
+
+	ctx = devm_kzalloc(dev, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->enable_gpio = devm_gpiod_get_optional(dev, "enable", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->enable_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->enable_gpio),
+				     "Failed to get enable-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	/*
+	 * downstream qcom,mdss-dsi-traffic-mode = "non_burst_sync_event", so no
+	 * BURST. It also sets qcom,mdss-dsi-bllp-power-mode and
+	 * -bllp-eof-power-mode, i.e. the link drops to LP during blanking, which
+	 * is MIPI_DSI_CLOCK_NON_CONTINUOUS here.
+	 */
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_HSE |
+			  MIPI_DSI_MODE_NO_EOT_PACKET |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	drm_panel_init(&ctx->panel, dev, &amami_novatek_panel_funcs,
+		       DRM_MODE_CONNECTOR_DSI);
+	ctx->panel.prepare_prev_first = true;
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to get backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		dev_err(dev, "Failed to attach to DSI host: %d\n", ret);
+		drm_panel_remove(&ctx->panel);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void amami_novatek_remove(struct mipi_dsi_device *dsi)
+{
+	struct amami_novatek *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id amami_novatek_of_match[] = {
+	{ .compatible = "sony,amami-novatek" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, amami_novatek_of_match);
+
+static struct mipi_dsi_driver amami_novatek_driver = {
+	.probe = amami_novatek_probe,
+	.remove = amami_novatek_remove,
+	.driver = {
+		.name = "panel-sony-amami-novatek",
+		.of_match_table = amami_novatek_of_match,
+	},
+};
+module_mipi_dsi_driver(amami_novatek_driver);
+
+MODULE_DESCRIPTION("DRM driver for Sony Xperia Z1 Compact Novatek 720p panel");
+MODULE_LICENSE("GPL");
