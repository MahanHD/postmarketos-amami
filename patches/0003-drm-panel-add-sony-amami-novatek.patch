+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Sony Xperia Z1 Compact (amami) Novatek 720p video mode DSI panel
+ *
+ * Sony shipped several panel vendors behind the same Novatek controller and
+ * selects between them at runtime by reading DCS register 0xa1. The command
+ * sequences and the ID values below were translated from the Sony downstream
+ * device tree (arch/arm/boot/dts/qcom/dsi-panel-amami.dtsi).
+ *
+ * Copyright (c) 2013-2014 Sony Mobile Communications AB.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+#define AMAMI_DCS_READ_ID	0xa1
+#define AMAMI_ID_ANY		0xff
+
+struct amami_variant;
+
+struct amami_novatek {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *enable_gpio;
+	const struct amami_variant *variant;
+};
+
+struct amami_variant {
+	const char *name;
+	u8 id;	/* byte 3 of the 0xa1 read; AMAMI_ID_ANY = fallback */
+	void (*init)(struct mipi_dsi_multi_context *dsi_ctx);
+};
+
+static inline struct amami_novatek *to_amami_novatek(struct drm_panel *panel)
+{
+	return container_of(panel, struct amami_novatek, panel);
+}
+
+static void amami_novatek_reset(struct amami_novatek *ctx)
+{
+	/*
+	 * Downstream qcom,mdss-dsi-reset-sequence = <1 20>, <0 200>, <1 20>,
+	 * expressed here in logical (active-low) terms.
+	 */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(20);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	msleep(200);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	/*
+	 * 20ms (the downstream value) is enough on a cold boot but not when
+	 * re-initialising after ENTER_SLEEP_MODE, e.g. on the console -> X
+	 * handoff, where the panel would come back blank. Be generous.
+	 */
+	msleep(120);
+}
