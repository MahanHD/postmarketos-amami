--- a/drivers/media/i2c/ccs/ccs-quirk.c
+++ b/drivers/media/i2c/ccs/ccs-quirk.c
@@ -236,6 +236,20 @@
 	return 0;
 }
 
+/* debug: give 0x0820 the per-lane bit rate instead of the bus total */
+static int imx200_pre_streamon(struct ccs_sensor *sensor)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&sensor->src->sd);
+	u32 rate = DIV_ROUND_UP(sensor->pll.op_bk.sys_clk_freq_hz,
+				1000000 / 256 / 256);
+
+	dev_info(&client->dev, "imx200: requested link rate 0x%08x (%u Hz op_sys)\n",
+		 rate, sensor->pll.op_bk.sys_clk_freq_hz);
+
+	return ccs_write_addr(sensor, CCS_R_REQUESTED_LINK_RATE, rate);
+}
+
 const struct ccs_quirk smiapp_imx200_quirk = {
 	.limits = imx200_limits,
+	.pre_streamon = imx200_pre_streamon,
 };
