From: MahanHD <mahanheidari2003@gmail.com>
Subject: [PATCH] debug: clk: qcom: gdsc: switch RETAIN_MEM_OFF at runtime

clk_qcom.retain_mem=N (or /sys/module/clk_qcom/parameters/retain_mem)
makes gdsc_disable() clear the memory-on bits again on domains that
carry RETAIN_MEM_OFF, so the next collapse powers their memories off.
For testing whether a GPU state that survives power cycles lives in the
retained memories.

---
--- a/drivers/clk/qcom/gdsc.c	2026-10-12 22:00:38.827355238 +0400
+++ b/drivers/clk/qcom/gdsc.c	2026-10-12 22:00:38.838779894 +0400
@@ -10,6 +10,7 @@
 #include <linux/jiffies.h>
 #include <linux/kernel.h>
 #include <linux/ktime.h>
+#include <linux/moduleparam.h>
 #include <linux/pm_domain.h>
 #include <linux/regmap.h>
 #include <linux/regulator/consumer.h>
@@ -204,6 +205,13 @@
 	return 0;
 }
 
+/*
+ * Debug: write N to drop RETAIN_MEM_OFF, so a collapse loses the memories
+ * again. Lets a power cycle be tried with and without them.
+ */
+static bool retain_mem = true;
+module_param(retain_mem, bool, 0644);
+
 static inline void gdsc_force_mem_on(struct gdsc *sc)
 {
 	int i;
@@ -340,7 +348,8 @@
 			return ret;
 	}
 
-	if ((sc->pwrsts & PWRSTS_OFF) && !(sc->flags & RETAIN_MEM_OFF))
+	if ((sc->pwrsts & PWRSTS_OFF) &&
+	    !(retain_mem && (sc->flags & RETAIN_MEM_OFF)))
 		gdsc_clear_mem_on(sc);
 
 	/*
