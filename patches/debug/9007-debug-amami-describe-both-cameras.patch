--- a/arch/arm/boot/dts/qcom/qcom-msm8974-sony-xperia-rhine-amami.dts
+++ b/arch/arm/boot/dts/qcom/qcom-msm8974-sony-xperia-rhine-amami.dts
@@ -376,3 +376,185 @@
 
 	status = "okay";
 };
+
+/*
+ * Only the rear (IMX200) is linked into the camss graph. The front (IMX132)
+ * cannot bind yet - its own PLL limits are broken (max_pll_op_clk 76 MHz against
+ * a 384 MHz minimum, op/vt clock limits all zero) - and camss waits for every
+ * linked sensor, so linking it would hold back /dev/media0. Relink it once it
+ * has a quirk.
+ *
+ * A sensor has to be linked into the camss graph for CCS at all: its
+ * ccs_get_hwconfig() uses fwnode_graph_get_endpoint_by_id(), which skips an
+ * endpoint with no available remote - unlinked, CCS probes -ENODEV without a
+ * word. The cost: camss registers /dev/media0 and its subdev nodes only once
+ * every linked sensor has bound, so if CCS fails, the CSID test-pattern path
+ * disappears with it. Unlink the sensors again to get it back.
+ *
+ * BRING-UP ONLY - debug/9007. Both sensors are now bound to the generic CCS driver
+ * ("nokia,smia"): their ID headers are SMIA 1.0 (IMX132) and SMIA++ (IMX200) layout,
+ * so CCS can drive them from their own capability registers, no vendor tables.
+ * CCS's reset is asserted-high in software, so XCLR (physically active low) is
+ * GPIO_ACTIVE_LOW here - the opposite of the imx219 description it replaced.
+ * The link frequencies are a spread for CCS's PLL solver to choose from.
+ *
+ * History: this first borrowed the imx219 driver purely to power the
+ * rear camera and read its 16-bit model ID at 0x0000: for anything that is not an
+ * IMX219, imx219 logs "chip id mismatch: 219!=<id>", and <id> is the number wanted.
+ * The part is believed to be an IMX220 from its geometry alone - 5248x3936 at
+ * 1/2.3" - but that has never been read off the chip. Replace all of this with the
+ * real sensor's binding once it is known.
+ */
+&rpm_requests {
+	regulators-1 {
+		/* downstream's cam_vio: 8941_lvs2, a switch off s3 at 1.8V */
+		pm8941_lvs2: lvs2 {};
+	};
+};
+
+&cci {
+	status = "okay";
+};
+
+&cci_i2c0 {
+	camera@10 {
+		compatible = "nokia,smia";
+		reg = <0x10>;
+
+		/*
+		 * 19.2 MHz, straight off XO. msm8974's MCLK RCGs have no M/N
+		 * counter - unlike apq8084's, whose table mmcc-msm8974 shares - so
+		 * the table's 24 MHz entry (GPLL0 / 5 * 1/5) silently comes out at
+		 * 120 MHz. The I2C side of the sensor does not care about INCK, so
+		 * this is enough to read the ID; debug/9008 lets imx219 accept it.
+		 */
+		clocks = <&mmcc CAMSS_MCLK0_CLK>;
+		assigned-clocks = <&mmcc CAMSS_MCLK0_CLK>;
+		assigned-clock-rates = <19200000>;
+		clock-frequency = <19200000>;
+
+		/*
+		 * imx219's supply names mapped onto amami's camera rails. Each is
+		 * pinned min=max by RPM at downstream's voltage, so the names cannot
+		 * mis-volt anything: VANA = cam_vana (l17, 2.7V), VDIG = cam_vio
+		 * (lvs2, 1.8V), VDDL = cam_vdig (l3, 1.2V). cam_vaf (l23) is the
+		 * focus actuator and is not needed to read an ID.
+		 */
+		vana-supply = <&pm8941_l17>;
+		vio-supply = <&pm8941_lvs2>;
+		vcore-supply = <&pm8941_l3>;
+
+		/*
+		 * XCLR is active low - downstream drives GPIO 94 high to release
+		 * it - and imx219 sets "reset" to 1 to run the sensor, so the line
+		 * is described active high here.
+		 */
+		reset-gpios = <&tlmm 94 GPIO_ACTIVE_LOW>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam_rear_default>;
+
+		port {
+			rear_cam_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <96000000 104000000 192000000 208000000 288000000 312000000 384000000 416000000 456000000 480000000>;
+				remote-endpoint = <&csiphy0_ep>;
+			};
+		};
+	};
+};
+
+&cci_i2c1 {
+	/*
+	 * Front camera, downstream camera@6c: CCI master 1, 7-bit 0x36, 2 lanes,
+	 * MCLK on GPIO 17 (cam_mclk2), reset on GPIO 18. Same three rails as the
+	 * rear. Modules SEM02BN1 / LGI02BN1, 1976x1200, no focus actuator.
+	 */
+	camera@36 {
+		compatible = "nokia,smia";
+		reg = <0x36>;
+
+		clocks = <&mmcc CAMSS_MCLK2_CLK>;
+		assigned-clocks = <&mmcc CAMSS_MCLK2_CLK>;
+		assigned-clock-rates = <19200000>;
+		clock-frequency = <19200000>;
+
+		vana-supply = <&pm8941_l17>;
+		vio-supply = <&pm8941_lvs2>;
+		vcore-supply = <&pm8941_l3>;
+
+		reset-gpios = <&tlmm 18 GPIO_ACTIVE_LOW>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam_front_default>;
+
+		port {
+			front_cam_ep: endpoint {
+				data-lanes = <1 2>;
+				link-frequencies = /bits/ 64 <96000000 104000000 192000000 208000000 288000000 312000000 384000000 416000000 456000000 480000000>;
+			};
+		};
+	};
+};
+
+&camss {
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+
+			/*
+			 * Downstream: csi-lane-mask 0x1f and csi-lane-assign 0x4320,
+			 * i.e. data on CSIPHY lanes 0, 2, 3, 4 with the clock on 1.
+			 */
+			csiphy0_ep: endpoint {
+				clock-lanes = <1>;
+				data-lanes = <0 2 3 4>;
+				/*
+				 * The IMX200's frame-start bursts are only caught
+				 * with a settle of about 30 ns; line data syncs up
+				 * to ~120 ns, so the D-PHY formula loses every
+				 * frame start.
+				 */
+				qcom,hs-settle-ns = <30>;
+				remote-endpoint = <&rear_cam_ep>;
+			};
+		};
+	};
+};
+
+&tlmm {
+	cam_rear_default: cam-rear-default-state {
+		mclk-pins {
+			pins = "gpio15";
+			function = "cam_mclk0";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		reset-pins {
+			pins = "gpio94";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+	};
+
+	cam_front_default: cam-front-default-state {
+		mclk-pins {
+			pins = "gpio17";
+			function = "cam_mclk2";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		reset-pins {
+			pins = "gpio18";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+	};
+};
