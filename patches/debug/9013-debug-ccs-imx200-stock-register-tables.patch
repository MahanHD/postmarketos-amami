+/*
+ * debug: the stock firmware's register tables for this module, from
+ * /system/vendor/camera/SOI20BS0_IMX200.dat (14.6.A.1.236): the init table,
+ * and the manufacturer-specific part of mode 0 (5248x3936), including the
+ * 4-lane setting at 0x0108 - the stock tables never write 0x0114. CCS keeps
+ * the standard size, binning, scaling, frame length and exposure registers.
+ */
+static unsigned int imx200_stock = 7;
+module_param(imx200_stock, uint, 0644);
+MODULE_PARM_DESC(imx200_stock, "debug: stock tables (1 init, 2 lanes, 4 mode 0 rest, 8 sizes, 16 clock, 32 d-phy)");
+
