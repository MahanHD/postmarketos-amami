+
+	if (imx200_stock & 1)
+		rval = ccs_write_addr_8s(sensor, init, ARRAY_SIZE(init));
+	if (rval)
+		return rval;
+
+	for (i = 0; i < ARRAY_SIZE(mode0) && !rval; i++) {
+		u16 r = mode0[i].reg;
+		bool lanes = r == 0x0108;
+		bool size = (r >= 0x13c0 && r <= 0x13c4) ||
+			    (r >= 0xad34 && r <= 0xad3f) ||
+			    (r >= 0x9030 && r <= 0x9037);
+
+		bool clk = r == 0x3004 || r == 0x3005 || r == 0x9229;
+		bool dphy = r >= 0x0830 && r <= 0x0847;
+
+		if ((lanes && (imx200_stock & 2)) ||
+		    (size && (imx200_stock & 8)) ||
+		    (clk && (imx200_stock & 16)) ||
+		    (dphy && (imx200_stock & 32)) ||
+		    (!lanes && !size && !clk && !dphy && (imx200_stock & 4)))
+			rval = ccs_write_addr_8s(sensor, &mode0[i], 1);
+	}
+
+	return rval;
+}
