--- a/drivers/irqchip/irq-qcom-mpm.c
+++ b/drivers/irqchip/irq-qcom-mpm.c
@@ -329,10 +329,29 @@
 
 static int qcom_mpm_syscore_suspend(void)
 {
-	if (!qcom_mpm_syscore_priv)
+	struct qcom_mpm_priv *priv = qcom_mpm_syscore_priv;
+	int i;
+
+	if (!priv)
 		return 0;
 
-	return mpm_pd_power_off(&qcom_mpm_syscore_priv->genpd);
+	/*
+	 * DEBUG: the ENABLE words as they stand at the moment vMPM is handed to
+	 * the RPM. 0076 asserts that whatever is still set here is exactly the
+	 * set of wakeup sources; this is what tests that. Note qcom_mpm_mask()
+	 * clears an ENABLE bit and the chip carries IRQCHIP_MASK_ON_SUSPEND, so
+	 * any pin whose irq was not wakeup-armed has had its bit wiped by
+	 * suspend_device_irqs() before we get here.
+	 *
+	 * SPMI (and so every PMIC wakeup, the RTC alarm included) is pin 62 =
+	 * ENABLE[1] bit 30 = 0x40000000. tsens is pin 2 = ENABLE[0] bit 2.
+	 */
+	for (i = 0; i < priv->reg_stride; i++)
+		pr_info("mpm: vMPM ENABLE[%d] = %#010x  (pins %d-%d)\n", i,
+			qcom_mpm_read(priv, MPM_REG_ENABLE, i),
+			i * 32, i * 32 + 31);
+
+	return mpm_pd_power_off(&priv->genpd);
 }
 
 static struct syscore_ops qcom_mpm_syscore_ops = {
