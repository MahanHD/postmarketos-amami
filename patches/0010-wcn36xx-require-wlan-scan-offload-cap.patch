@@ -639,8 +639,16 @@
 {
 	struct wcn36xx *wcn = hw->priv;
 
+	/*
+	 * SCAN_OFFLOAD on its own is not enough. Pronto firmware advertises it
+	 * while having no handler for START_SCAN_OFFLOAD at all, so the request
+	 * goes unanswered and every scan costs a ten second timeout. Firmware
+	 * that does implement the message advertises WLAN_SCAN_OFFLOAD as well,
+	 * so require both and fall back to the software scan otherwise.
+	 */
 	if (!wcn36xx_scan_offload ||
-	    !wcn36xx_firmware_get_feat_caps(wcn->fw_feat_caps, SCAN_OFFLOAD)) {
+	    !wcn36xx_firmware_get_feat_caps(wcn->fw_feat_caps, SCAN_OFFLOAD) ||
+	    !wcn36xx_firmware_get_feat_caps(wcn->fw_feat_caps, WLAN_SCAN_OFFLOAD)) {
 		/* fallback to mac80211 software scan */
 		return 1;
 	}
@@ -679,7 +687,8 @@
 	mutex_unlock(&wcn->scan_lock);
 
 	if (wcn36xx_scan_offload &&
-	    wcn36xx_firmware_get_feat_caps(wcn->fw_feat_caps, SCAN_OFFLOAD)) {
+	    wcn36xx_firmware_get_feat_caps(wcn->fw_feat_caps, SCAN_OFFLOAD) &&
+	    wcn36xx_firmware_get_feat_caps(wcn->fw_feat_caps, WLAN_SCAN_OFFLOAD)) {
 		/* ieee80211_scan_completed will be called on FW scan
 		 * indication */
 		wcn36xx_smd_stop_hw_scan(wcn);
