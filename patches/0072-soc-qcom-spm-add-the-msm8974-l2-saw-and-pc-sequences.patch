+/*
+ * The same SAW2 v2.1 block, but with the PMIC data registers that the L2
+ * instance needs and the per-CPU ones do not.
+ *
+ * They are at 0x40/0x44, exactly where v2.3 has them - the table above is
+ * simply incomplete rather than describing a different layout, because the
+ * existing 8974 and 8226 CPU entries carry no pmic_data. Kept separate instead
+ * of extending that table, so the CPU SAWs do not start having zeroes written
+ * over their PMIC data; downstream never writes those on a CPU SAW.
+ */
+static const u16 spm_reg_offset_v2_1_l2[SPM_REG_NR] = {
+	[SPM_REG_CFG]		= 0x08,
+	[SPM_REG_SPM_CTL]	= 0x30,
+	[SPM_REG_DLY]		= 0x34,
+	[SPM_REG_PMIC_DATA_0]	= 0x40,
+	[SPM_REG_PMIC_DATA_1]	= 0x44,
+	[SPM_REG_SEQ_ENTRY]	= 0x80,
+};
+
 /* SPM register data for 8974, 8084 */
 static const struct spm_reg_data spm_reg_8974_8084_cpu  = {
 	.reg_offset = spm_reg_offset_v2_1,
 	.spm_cfg = 0x1,
 	.spm_dly = 0x3C102800,
+	/*
+	 * wfi, then spc, then pc - the three sequences downstream carries for
+	 * this SAW, concatenated, with start_index pointing at each boundary.
+	 *
+	 * pc differs from spc in exactly one byte: 0x03 becomes 0x07 at offset
+	 * six of the block. That bit is what also lets L2 go down, so a core
+	 * entering pc rather than spc is what makes a full system collapse
+	 * possible. Nothing selects PM_SLEEP_MODE_PC yet.
+	 */
 	.seq = { 0x03, 0x0B, 0x0F, 0x00, 0x20, 0x80, 0x10, 0xE8, 0x5B, 0x03,
 		0x3B, 0xE8, 0x5B, 0x82, 0x10, 0x0B, 0x30, 0x06, 0x26, 0x30,
-		0x0F },
+		0x0F, 0x00, 0x20, 0x80, 0x10, 0xE8, 0x5B, 0x07, 0x3B, 0xE8,
+		0x5B, 0x82, 0x10, 0x0B, 0x30, 0x06, 0x26, 0x30, 0x0F },
 	.start_index[PM_SLEEP_MODE_STBY] = 0,
 	.start_index[PM_SLEEP_MODE_SPC] = 3,
+	.start_index[PM_SLEEP_MODE_PC] = 21,
+};
+
+/*
+ * The L2/APCS SAW, which on 8974 is the one that has to go down for the SoC to
+ * collapse at all. Values come out of downstream's own device tree for this
+ * board (qcom,spm@f9012000), read with tools/romdtb.py.
+ *
+ * Its modes are ret and pc rather than the CPUs' wfi/spc/pc, so the sequences
+ * are concatenated in that order and the start indices follow. STBY is left
+ * unset, which means index 0 - the ret sequence - and that is what the probe
+ * selects as the default; the L2 has no standby sequence of its own.
+ *
+ * This is inert until something drives PM_SLEEP_MODE_PC. Nothing in tree does:
+ * cpuidle-qcom-spm is strictly per-CPU, and on the arm64 SoCs that have L2
+ * entries it is PSCI firmware that drives them.
+ */
+static const struct spm_reg_data spm_reg_8974_8084_l2 = {
+	.reg_offset = spm_reg_offset_v2_1_l2,
+	.spm_cfg = 0x14,
+	.spm_dly = 0x3C102800,
+	.pmic_data[0] = 0x02030080,
+	.pmic_data[1] = 0x00030000,
+	.seq = { 0x1F, 0x00, 0x03, 0x00, 0x0F, 0x00, 0x10, 0x32, 0xB0, 0x11,
+		0x42, 0x07, 0x01, 0xB0, 0x12, 0x44, 0x50, 0x02, 0x32, 0x50,
+		0x0F },
+	.start_index[PM_SLEEP_MODE_RET] = 0,
+	.start_index[PM_SLEEP_MODE_PC] = 5,
 };
 
