--- a/arch/arm/boot/dts/qcom/qcom-msm8974.dtsi
+++ b/arch/arm/boot/dts/qcom/qcom-msm8974.dtsi
@@ -2329,6 +2329,14 @@
 					<&ocmemnoc OCMEM_VNOC_MAS_GFX3D &ocmemnoc OCMEM_SLV_OCMEM>;
 			interconnect-names = "gfx-mem", "ocmem";
 
+			/*
+			 * gfx3d_user and gfx3d_priv. The context banks sit 0x1000
+			 * apart and qcom_iommu derives each ASID from reg / 0x1000,
+			 * so gfx3d_user is 1 and not 0 - which is what the stale
+			 * placeholder that used to sit here got wrong.
+			 */
+			iommus = <&gpu_iommu 1>, <&gpu_iommu 2>;
+
 			status = "disabled";
 
 			gpu_opp_table: opp-table {
@@ -2373,6 +2381,18 @@
 			interrupts = <GIC_SPI 38 IRQ_TYPE_LEVEL_HIGH>;
 			power-domains = <&mmcc OXILICX_GDSC>;
 
+			/*
+			 * Verbatim from downstream's kgsl_iommu node. TrustZone
+			 * does not own this IOMMU, so these have to be written
+			 * from here or the GPU never comes up behind it.
+			 */
+			qcom,iommu-bfb-regs = <0x204c 0x2050 0x2514 0x2540
+					       0x256c 0x20ac 0x215c 0x220c
+					       0x2314 0x2394 0x2414 0x2008>;
+			qcom,iommu-bfb-data = <0x3 0x0 0x4 0x10
+					       0x0 0x0 0x1 0x21
+					       0x0 0x1 0x81 0x0>;
+
 			/* gfx3d_user */
 			iommu-ctx@1000 {
 				compatible = "qcom,msm-iommu-v1-ns";
