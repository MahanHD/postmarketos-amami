+static int wcd_slim_get_slave_port(unsigned int ch_num)
+{
+	printk("WCD: %s", __func__);
+	int ret = 0;
+
+	ret = (ch_num - BASE_CH_NUM);
+	if (ret < 0) {
+		pr_err("%s: Error:- Invalid slave port found = %d\n",
+			__func__, ret);
+		return -EINVAL;
+	}
+	return ret;
+}
