+static int wcd_slim_rx_vport_validation(u32 port_id,
+				struct list_head *codec_dai_list)
+{
+	printk("WCD: %s", __func__);
+	struct wcd_slim_ch *ch;
+	int ret = 0;
+
+	list_for_each_entry(ch,
+		codec_dai_list, list) {
+		if (ch->port == port_id) {
+			ret = -EINVAL;
+			break;
+		}
+	}
+	return ret;
