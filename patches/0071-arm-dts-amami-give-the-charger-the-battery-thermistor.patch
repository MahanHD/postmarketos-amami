+&pm8941_vadc {
+	/*
+	 * The battery thermistor divider runs off the VADC's own reference,
+	 * so read it as a fraction of that, as downstream does
+	 * (qcom,calibration-type = "ratiometric"): its table is on that
+	 * scale, and an absolute reading shifts it by the reference's error.
+	 */
+	channel@30 {
+		qcom,ratiometric;
+	};
+};
