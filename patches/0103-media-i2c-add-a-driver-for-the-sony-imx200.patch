+/*
+ * Clocks for a 19.2 MHz external clock and a 288 MHz link, as the CCS driver
+ * computes them, plus the link rate request it writes. 0x0304 is left at its
+ * reset value of 1.
+ */
+static const struct cci_reg_sequence imx200_pll_regs[] = {
+	{ CCI_REG8(0x0301), 0x07 }, { CCI_REG8(0x0303), 0x02 },
+	{ CCI_REG8(0x0305), 0x06 }, { CCI_REG16(0x0306), 0x006c },
+	{ CCI_REG8(0x0309), 0x0a }, { CCI_REG8(0x030b), 0x01 },
+	{ CCI_REG32(0x0820), 0x0927c000 },
+};
+
+struct imx200_mode {
+	unsigned int width;
+	unsigned int height;
+	/* the area of the pixel array it reads */
+	struct v4l2_rect crop;
+	/* default frame length, from stock */
+	unsigned int fll_def;
+	u32 pixel_rate;
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+};
+
+#define IMX200_MODE(w, h, l, t, cw, ch, fll, rate, r) {		\
+	.width = w, .height = h,					\
+	.crop = { .left = l, .top = t, .width = cw, .height = ch },	\
+	.fll_def = fll, .pixel_rate = rate,				\
+	.regs = r, .num_regs = ARRAY_SIZE(r),				\
+}
+
+/*
+ * Stock modes 0, 5, 2 and 1: full resolution, 2x2 binned, 2x2 binned and
+ * cropped to 16:9, and 4x4 (binned and skipped) for previews.
+ */
+static const struct imx200_mode imx200_modes[] = {
+	IMX200_MODE(5248, 3936, 0, 0, 5248, 3936, 3992,
+		    IMX200_PIXEL_RATE_FULL, imx200_mode_5248_3936_regs),
+	IMX200_MODE(2624, 1976, 0, 0, 5248, 3952, 2024,
+		    IMX200_PIXEL_RATE_BINNED, imx200_mode_2624_1976_regs),
+	IMX200_MODE(2624, 1480, 0, 488, 5248, 2960, 1528,
+		    IMX200_PIXEL_RATE_BINNED, imx200_mode_2624_1480_regs),
+	IMX200_MODE(1312, 988, 0, 0, 5248, 3952, 1036,
+		    IMX200_PIXEL_RATE_BINNED, imx200_mode_1312_988_regs),
+};
