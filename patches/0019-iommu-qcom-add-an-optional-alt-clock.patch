 	/*
+	 * Some instances need a further clock running before their registers
+	 * respond at all. On msm8974 the GPU IOMMU sits behind the GFX3D clock,
+	 * not just the OXILICX interface and bus clocks, and touching a context
+	 * bank without it wedges the boot.
+	 */
+	clk = devm_clk_get_optional(dev, "alt");
+	if (IS_ERR(clk)) {
+		dev_err(dev, "failed to get alt clock\n");
+		return PTR_ERR(clk);
+	}
+	qcom_iommu->clks[CLK_ALT].clk = clk;
