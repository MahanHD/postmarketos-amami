From: MahanHD <mahanheidari2003@gmail.com>
Subject: [PATCH] media: camss: vfe-4-1: stop RDI writes at the end of the buffer

RDI write masters run frame-based, and in that mode the write master
ignores the image size: it stores whatever frame arrives from the buffer
address on. A sensor that sends a larger frame than its format says then
writes past the buffer into whatever memory follows. On msm8974 the IMX200
does this for the first frame or two of every binned stream, because
starting the stream resets its readout registers: a 25 MB frame went into a
6 MB buffer, and a buffer that was never queued had its contents
overwritten.

On VFE 4.1 write the RDI masters line-based instead, with the image size and
buffer configuration taken from the format, as the PIX path does. An
oversized frame then stops at the end of the buffer. Line-based mode writes
each line in whole 128-bit units, so RDI bytesperline is aligned to 16 bytes,
as it already is for PIX. VFE 4.7 and 4.8 are left as they are.

--- a/drivers/media/platform/qcom/camss/camss-vfe-gen1.h
+++ b/drivers/media/platform/qcom/camss/camss-vfe-gen1.h
@@ -45,6 +45,9 @@
 	void (*set_qos)(struct vfe_device *vfe);
 	void (*set_xbar_cfg)(struct vfe_device *vfe, struct vfe_output *output, u8 enable);
 	void (*wm_frame_based)(struct vfe_device *vfe, u8 wm, u8 enable);
+	/* optional: RDI writes bounded by the format, in place of frame-based */
+	void (*wm_rdi_line_based)(struct vfe_device *vfe, u8 wm,
+				  struct v4l2_pix_format_mplane *pix, u8 enable);
 	void (*wm_line_based)(struct vfe_device *vfe, u32 wm, struct v4l2_pix_format_mplane *pix,
 			      u8 plane, u32 enable);
 	void (*wm_set_ub_cfg)(struct vfe_device *vfe, u8 wm, u16 offset, u16 depth);
--- a/drivers/media/platform/qcom/camss/camss-vfe-gen1.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe-gen1.c
@@ -66,7 +66,10 @@
 	spin_lock_irqsave(&vfe->output_lock, flags);
 
 	if (line->id != VFE_LINE_PIX) {
-		vfe->ops_gen1->wm_frame_based(vfe, output->wm_idx[0], 0);
+		if (vfe->ops_gen1->wm_rdi_line_based)
+			vfe->ops_gen1->wm_rdi_line_based(vfe, output->wm_idx[0], NULL, 0);
+		else
+			vfe->ops_gen1->wm_frame_based(vfe, output->wm_idx[0], 0);
 		vfe->ops_gen1->bus_disconnect_wm_from_rdi(vfe, output->wm_idx[0], line->id);
 		vfe->ops_gen1->enable_irq_wm_line(vfe, output->wm_idx[0], line->id, 0);
 		vfe->ops_gen1->set_cgc_override(vfe, output->wm_idx[0], 0);
@@ -244,7 +247,11 @@
 		vfe->ops_gen1->set_rdi_cid(vfe, line->id, 0);
 		vfe->ops_gen1->wm_set_ub_cfg(vfe, output->wm_idx[0],
 					    (ub_size + 1) * output->wm_idx[0], ub_size);
-		vfe->ops_gen1->wm_frame_based(vfe, output->wm_idx[0], 1);
+		if (vfe->ops_gen1->wm_rdi_line_based)
+			vfe->ops_gen1->wm_rdi_line_based(vfe, output->wm_idx[0],
+							 &line->video_out.active_fmt.fmt.pix_mp, 1);
+		else
+			vfe->ops_gen1->wm_frame_based(vfe, output->wm_idx[0], 1);
 		vfe->ops_gen1->wm_enable(vfe, output->wm_idx[0], 1);
 		vfe->ops_gen1->bus_reload_wm(vfe, output->wm_idx[0]);
 	} else {
--- a/drivers/media/platform/qcom/camss/camss-vfe-4-1.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe-4-1.c
@@ -278,6 +278,31 @@
 			1 << VFE_0_BUS_IMAGE_MASTER_n_WR_CFG_FRM_BASED_SHIFT);
 }
 
+/*
+ * In frame-based mode a write master ignores the image size and stores a frame
+ * of any length from the buffer address on, so a sensor sending more than its
+ * format says writes past the buffer. Line-based mode stops at the image size.
+ * It writes each line in whole 128-bit units, which is why RDI bytesperline is
+ * aligned to 16 here (see msm_vfe_register_entities()).
+ */
+static void vfe_wm_rdi_line_based(struct vfe_device *vfe, u8 wm,
+				  struct v4l2_pix_format_mplane *pix, u8 enable)
+{
+	u32 size = 0, cfg = 0;
+
+	if (enable) {
+		/* in 64-bit words */
+		u32 wpl = DIV_ROUND_UP(pix->plane_fmt[0].bytesperline, 8);
+
+		size = ((wpl + 1) / 2 - 1) << 16 | (pix->height - 1);
+		cfg = wpl << 16 | (pix->height - 1) << 4 | 0x3;
+	}
+
+	vfe_wm_frame_based(vfe, wm, 0);
+	writel_relaxed(size, vfe->base + VFE_0_BUS_IMAGE_MASTER_n_WR_IMAGE_SIZE(wm));
+	writel_relaxed(cfg, vfe->base + VFE_0_BUS_IMAGE_MASTER_n_WR_BUFFER_CFG(wm));
+}
+
 static void vfe_get_wm_sizes(struct v4l2_pix_format_mplane *pix, u8 plane,
 			     u16 *width, u16 *height, u16 *bytesperline)
 {
@@ -976,6 +1001,7 @@
 	.wm_frame_based = vfe_wm_frame_based,
 	.wm_get_ping_pong_status = vfe_wm_get_ping_pong_status,
 	.wm_line_based = vfe_wm_line_based,
+	.wm_rdi_line_based = vfe_wm_rdi_line_based,
 	.wm_set_framedrop_pattern = vfe_wm_set_framedrop_pattern,
 	.wm_set_framedrop_period = vfe_wm_set_framedrop_period,
 	.wm_set_ping_addr = vfe_wm_set_ping_addr,
--- a/drivers/media/platform/qcom/camss/camss-vfe.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe.c
@@ -23,6 +23,7 @@
 #include <media/v4l2-subdev.h>
 
 #include "camss-vfe.h"
+#include "camss-vfe-gen1.h"
 #include "camss.h"
 
 #define MSM_VFE_NAME "msm_vfe"
@@ -2068,6 +2069,9 @@
 		if (i == VFE_LINE_PIX) {
 			video_out->bpl_alignment = 16;
 			video_out->line_based = 1;
+		} else if (vfe->ops_gen1 && vfe->ops_gen1->wm_rdi_line_based) {
+			/* written line-based too, in whole 128-bit units per line */
+			video_out->bpl_alignment = 16;
 		}
 
 		video_out->nformats = vfe->line[i].nformats;
