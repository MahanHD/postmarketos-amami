+&pm8841_1 {
+	regulators {
+		compatible = "qcom,pm8841-regulators";
+
+		/*
+		 * VDD_APC, the Krait rail: s5 leads s6-s8. Stock sets it through
+		 * the L2 SAW (msm_spm_set_vdd()); nothing here can do that yet,
+		 * so it is held at the 900mV the bootloader leaves it at
+		 * (CORE_VOLTAGE_BOOTUP in stock's krait-regulator.c, and what
+		 * its voltage register reads).
+		 */
+		vdd_apc: s5 {
+			regulator-min-microvolt = <900000>;
+			regulator-max-microvolt = <900000>;
+			regulator-always-on;
+			regulator-boot-on;
+		};
+	};
+};
