From: MahanHD <mahanheidari2003@gmail.com>
Subject: [PATCH] drm/msm/a3xx: run kgsl's power-on fixup the way kgsl does

The downstream kgsl driver runs a short compute dispatch on every a3xx
before the first submission after each power-on, to set up the shader
processor after power collapse ("Some targets require a special
workaround shader to be executed after power-collapse"). The stock
kernel of the Xperia Z1 Compact has it too. drm/msm never ran it.

Do it as kgsl does: build the commands once into a GPU read-only buffer,
and call that buffer with CP_INDIRECT_BUFFER_PFD (prefetch disabled),
with register protection off around it since it writes RBBM_CLOCK_CTL,
from the first submission after every hw_init: at power-on, on runtime
resume and after a GPU reset. hw_init has already waited for CP_ME_INIT
to finish by then, as kgsl does. The 491 dwords are identical to the
buffer the stock kernel's adreno_a3xx_pwron_fixup_init() builds, taken
by running that function from the stock kernel image.

An earlier version emitted the same commands inline in the ring, right
after CP_ME_INIT; there the CP sometimes stalled at the first wait for
idle at power-up.

---
--- a/drivers/gpu/drm/msm/adreno/a3xx_gpu.h	2026-10-11 22:27:29.694599889 +0400
+++ b/drivers/gpu/drm/msm/adreno/a3xx_gpu.h	2026-10-11 22:28:17.013565229 +0400
@@ -20,6 +20,12 @@
 
 	/* if OCMEM is used for GMEM: */
 	struct adreno_ocmem ocmem;
+
+	/* kgsl's power-on fixup, run before the first submit after power-on */
+	struct drm_gem_object *pwron_fixup_bo;
+	uint64_t pwron_fixup_iova;
+	uint32_t pwron_fixup_dwords;
+	bool pwron_fixup_pending;
 };
 #define to_a3xx_gpu(x) container_of(x, struct a3xx_gpu, base)
 
--- a/drivers/gpu/drm/msm/adreno/a3xx_gpu.c	2026-10-11 22:27:29.694599889 +0400
+++ b/drivers/gpu/drm/msm/adreno/a3xx_gpu.c	2026-10-11 22:28:17.048606559 +0400
@@ -28,11 +28,330 @@
 static void a3xx_dump(struct msm_gpu *gpu);
 static bool a3xx_idle(struct msm_gpu *gpu);
 
+/*
+ * The a3xx power-on fixup of the downstream kgsl driver
+ * (adreno_a3xx_pwron_fixup_init()): "Some targets require a special
+ * workaround shader to be executed after power-collapse". It is a small
+ * compute dispatch over the shader processor. kgsl, and the stock kernel of
+ * the Xperia Z1 Compact, build it once into a GPU read-only buffer and call
+ * it, with prefetch disabled and register protection off (it writes
+ * RBBM_CLOCK_CTL), from the first submission after each power-on. The
+ * buffer built here is identical, dword for dword, to the one the stock
+ * kernel builds.
+ */
+static const u32 a3xx_pwron_fixup_fs[] = {
+	0x00000000, 0x302cc300, 0x00000000, 0x302cc304,
+	0x00000000, 0x302cc308, 0x00000000, 0x302cc30c,
+	0x00000000, 0x302cc310, 0x00000000, 0x302cc314,
+	0x00000000, 0x302cc318, 0x00000000, 0x302cc31c,
+	0x00000000, 0x302cc320, 0x00000000, 0x302cc324,
+	0x00000000, 0x302cc328, 0x00000000, 0x302cc32c,
+	0x00000000, 0x302cc330, 0x00000000, 0x302cc334,
+	0x00000000, 0x302cc338, 0x00000000, 0x302cc33c,
+	0x00000000, 0x00000400, 0x00020000, 0x63808003,
+	0x00060004, 0x63828007, 0x000a0008, 0x6384800b,
+	0x000e000c, 0x6386800f, 0x00120010, 0x63888013,
+	0x00160014, 0x638a8017, 0x001a0018, 0x638c801b,
+	0x001e001c, 0x638e801f, 0x00220020, 0x63908023,
+	0x00260024, 0x63928027, 0x002a0028, 0x6394802b,
+	0x002e002c, 0x6396802f, 0x00320030, 0x63988033,
+	0x00360034, 0x639a8037, 0x003a0038, 0x639c803b,
+	0x003e003c, 0x639e803f, 0x00000000, 0x00000400,
+	0x00000003, 0x80d60003, 0x00000007, 0x80d60007,
+	0x0000000b, 0x80d6000b, 0x0000000f, 0x80d6000f,
+	0x00000013, 0x80d60013, 0x00000017, 0x80d60017,
+	0x0000001b, 0x80d6001b, 0x0000001f, 0x80d6001f,
+	0x00000023, 0x80d60023, 0x00000027, 0x80d60027,
+	0x0000002b, 0x80d6002b, 0x0000002f, 0x80d6002f,
+	0x00000033, 0x80d60033, 0x00000037, 0x80d60037,
+	0x0000003b, 0x80d6003b, 0x0000003f, 0x80d6003f,
+	0x00000000, 0x03000000, 0x00000000, 0x00000000,
+};
+
+static u32 *a3xx_fixup_pkt0(u32 *cmds, u16 reg, u16 cnt)
+{
+	*cmds++ = CP_TYPE0_PKT | ((cnt - 1) << 16) | (reg & 0x7fff);
+	return cmds;
+}
+
+static u32 *a3xx_fixup_pkt3(u32 *cmds, u8 opcode, u16 cnt)
+{
+	*cmds++ = CP_TYPE3_PKT | ((cnt - 1) << 16) | (opcode << 8);
+	return cmds;
+}
+
+static u32 *a3xx_fixup_write(u32 *cmds, u32 reg, u32 val)
+{
+	cmds = a3xx_fixup_pkt0(cmds, reg, 1);
+	*cmds++ = val;
+	return cmds;
+}
+
+static int a3xx_pwron_fixup_init(struct msm_gpu *gpu)
+{
+	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+	struct a3xx_gpu *a3xx_gpu = to_a3xx_gpu(adreno_gpu);
+	u32 *start, *cmds;
+
+	start = msm_gem_kernel_new(gpu->dev, PAGE_SIZE,
+			MSM_BO_WC | MSM_BO_GPU_READONLY, gpu->aspace,
+			&a3xx_gpu->pwron_fixup_bo, &a3xx_gpu->pwron_fixup_iova);
+	if (IS_ERR(start))
+		return PTR_ERR(start);
+
+	msm_gem_object_set_name(a3xx_gpu->pwron_fixup_bo, "pwron_fixup");
+
+	cmds = start;
+
+	cmds = a3xx_fixup_pkt0(cmds, REG_A3XX_UCHE_CACHE_INVALIDATE0_REG, 2);
+	*cmds++ = 0x00000000;
+	*cmds++ = 0x90000000;
+	cmds = a3xx_fixup_pkt3(cmds, CP_WAIT_FOR_IDLE, 1);
+	*cmds++ = 0x00000000;
+	cmds = a3xx_fixup_pkt3(cmds, CP_REG_RMW, 3);
+	*cmds++ = REG_A3XX_RBBM_CLOCK_CTL;
