--- a/drivers/media/i2c/ccs/ccs-quirk.c
+++ b/drivers/media/i2c/ccs/ccs-quirk.c
@@ -215,3 +215,27 @@
 const struct ccs_quirk smiapp_tcm8500md_quirk = {
 	.limits = tcm8500md_limits,
 };
+
+/*
+ * IMX200 limits its op_sys_clk to 169-1100 MHz, which is the bit rate of one
+ * lane: four lanes at 1.1 Gbit/s are what a 20 Mpixel sensor needs. Without
+ * the lane speed model the PLL runs every lane at the total bus bit rate, four
+ * times the link frequency it reports. Its CCS-only clock_calculation register
+ * cannot say so, so set the limits here, before the link frequencies are
+ * checked against them.
+ */
+static int imx200_limits(struct ccs_sensor *sensor)
+{
+	ccs_replace_limit(sensor, CCS_L_CLOCK_CALCULATION, 0,
+			  CCS_CLOCK_CALCULATION_LANE_SPEED |
+			  CCS_CLOCK_CALCULATION_LINK_DECOUPLED);
+	ccs_replace_limit(sensor, CCS_L_NUM_OF_VT_LANES, 0, 0);
+	ccs_replace_limit(sensor, CCS_L_NUM_OF_OP_LANES, 0,
+			  sensor->hwcfg.lanes - 1);
+
+	return 0;
+}
+
+const struct ccs_quirk smiapp_imx200_quirk = {
+	.limits = imx200_limits,
+};
