 			interconnect-names = "gfx-mem", "ocmem";
 
-			// iommus = <&gpu_iommu 0>;
+			/*
+			 * All three stream IDs downstream maps: gfx3d_user,
+			 * gfx3d_priv and gfx3d_spare. The cell is a stream ID
+			 * here, not a context bank index - arm-smmu does the
+			 * stream matching itself, which is what this hardware
+			 * needs and what qcom_iommu cannot do. Mapping only
+			 * user leaves the GPU's other traffic untranslated, and
+			 * it submits work that never completes.
+			 */
+			iommus = <&gpu_smmu 0>, <&gpu_smmu 1>, <&gpu_smmu 2>;
 
 			status = "disabled";
 
@@ -2201,6 +2210,60 @@
 			};
 		};
 
+		/*
+		 * This is a plain ARM SMMU, whatever its downstream name: the
+		 * stream match table sits at GR0+0x800, CBAR at GR1, and the
+		 * context banks at base+0x8000, all exactly where arm-smmu.c
+		 * expects them. Downstream maps stream IDs 0, 1 and 2 -
+		 * gfx3d_user, gfx3d_priv and gfx3d_spare - onto three context
+		 * banks; arm-smmu derives the bank count from its own ID
+		 * registers, so only the interrupts are listed here.
+		 */
+		gpu_smmu: iommu@fdb10000 {
+			compatible = "qcom,msm8974-smmu-v1", "arm,smmu-v1";
+			reg = <0xfdb10000 0x10000>;
+
+			#global-interrupts = <1>;
+			#iommu-cells = <1>;
+
+			/*
+			 * The global fault is SPI 38, as downstream's
+			 * kgsl_iommu node says. The context banks are the
+			 * subtle part: arm-smmu indexes this list by
+			 * CBAR.IRPTNDX, not by context bank number, and on
+			 * SMMUv1 it hands out IRPTNDX round-robin from 1. The
+			 * hardware raises a bank's fault on SPI 240 + IRPTNDX,
+			 * so the list has to start at 240 even though nothing
+			 * is ever assigned index 0.
+			 *
+			 * Measured, with the other bank idle as a control:
+			 * context bank 1 carries IRPTNDX 2, and when it alone
+			 * latched a translation fault, SPI 242 alone went
+			 * pending. Downstream lists 241 for all three of its
+			 * contexts, which only happens to be right for the one
+			 * that lands on index 1.
+			 *
+			 * Getting this wrong is nearly silent: the SMMU latches
+			 * FSR and terminates the transaction either way. Off by
+			 * one it is worse than silent - the fault arrives on a
+			 * line bound to a different bank, whose handler reads a
+			 * clean FSR and returns IRQ_NONE, so the level-triggered
+			 * line storms until the kernel disables it with
+			 * "nobody cared".
+			 */
+			interrupts = <GIC_SPI 38 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 240 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 241 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 242 IRQ_TYPE_LEVEL_HIGH>;
+
+			clocks = <&mmcc OXILICX_AHB_CLK>,
+				 <&mmcc OXILICX_AXI_CLK>,
+				 <&mmcc OXILI_GFX3D_CLK>;
+			clock-names = "iface", "bus", "core";
+
+			power-domains = <&mmcc OXILICX_GDSC>;
+		};
+
