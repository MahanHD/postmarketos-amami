+/*
+ * Wait for a dying core to have reached the collapse in qcom_cpu_die(). The
+ * release sequence below is a cold-boot power-up and ends by asserting CLAMP and
+ * COREPOR_RST, which resets the SoC if the core is still live, so refusing the
+ * online is very much the better failure.
+ */
+static bool qcom_cpu_wait_parked(unsigned int cpu)
 {
-	int ret = 0;
+	int i;
 
-	if (!per_cpu(cold_boot_done, cpu)) {
-		ret = func(cpu);
-		if (!ret)
