 static DEFINE_PER_CPU(int, cold_boot_done);
 
+/*
+ * Wait for a dying core to have collapsed in qcom_cpu_die(). The release
+ * sequence below is a cold-boot power-up and ends by asserting CLAMP and
+ * COREPOR_RST, which resets the SoC if the core is still live, so refusing the
+ * online is very much the better failure.
+ *
+ * The flag only says the core is about to collapse: the SCM call can return
+ * instead, when an interrupt is pending, and the core then loops round to try
+ * again. What says it has happened is the ACC's power status, the register
+ * downstream polls in msm_pm_wait_cpu_shutdown() (qcom,cpu-sleep-status,
+ * 0xf9088008 + cpu * 0x10000, mask 0x80000), giving each attempt 2 ms.
+ */
+static bool qcom_cpu_wait_parked(unsigned int cpu)
+{
+	void __iomem *sts = per_cpu(qcom_cpu_acc, cpu) + ACC_CPU_PWR_STS;
+	int i, j;
+
+	for (i = 0; i < 1000; i++) {
+		if (READ_ONCE(per_cpu(qcom_cpu_parked, cpu))) {
+			for (j = 0; j < 20; j++) {
+				if (readl_relaxed(sts) & ACC_CPU_PWR_STS_COLLAPSED) {
+					WRITE_ONCE(per_cpu(qcom_cpu_parked, cpu), false);
+					return true;
+				}
+				udelay(100);
+			}
+		}
+		udelay(10);
+	}
+
+	return false;
+}
