+static int qcom_boot_secondary(unsigned int cpu, int (*func)(unsigned int))
+{
+	int ret;
+
+	if (per_cpu(cold_boot_done, cpu)) {
+		/*
+		 * A re-online. qcom_cpu_die() powered this core off, so the
+		 * release sequence has to run again - it is what brings a
+		 * powered-down core back in at the cold boot address, and
+		 * __cpu_up() has refreshed secondary_data for us. Only do it
+		 * once the core is known to be down.
+		 */
+		if (!qcom_cpu_wait_parked(cpu))
+			return -EBUSY;
+	}
+
+	ret = func(cpu);
+	if (ret)
+		return ret;
+	per_cpu(cold_boot_done, cpu) = true;
