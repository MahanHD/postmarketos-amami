+static int qcom_smgr_register_sensor(struct qcom_smgr *smgr,
+				     struct qcom_smgr_sensor *sensor)
+{
+	const char *name = qcom_smgr_sensor_type_platform_names[sensor->type];
+	int ret;
+
+	ret = qcom_smgr_register_one(smgr, sensor, name, sensor->id);
+	if (ret)
+		return ret;
+
+	/*
+	 * A prox/light part carries ambient light as its secondary data type,
+	 * and that needs an IIO device of its own because it is a separate
+	 * subscription. The platform device ID has to differ from the primary
+	 * one, hence the same top-bit marker the report IDs use.
+	 */
+	if (sensor->type == SNS_SMGR_SENSOR_TYPE_PROX_LIGHT &&
+	    sensor->data_type_count > SNS_SMGR_DATA_TYPE_SECONDARY)
+		ret = qcom_smgr_register_one(smgr, sensor, "qcom-smgr-light",
+					     sensor->id |
+						SMGR_SECONDARY_REPORT_FLAG);
+
+	return ret;
