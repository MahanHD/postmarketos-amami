From: MahanHD <mahanheidari2003@gmail.com>
Subject: [PATCH] iio: qcom-smgr: wait for the DSP to bring its sensors up

The sensor manager service appears before the DSP has brought every
sensor up. Asked too early, it times out or refuses (0x701 for the
accelerometer), and probe failed for good, which on the Xperia Z1
Compact left the phone without sensors on some boots. The DSP needs
registry reads (qcom_sns_reg) to bring them up, and a retry loop inside
probe only held those up until it gave up.

Probe now returns at once and enumerates from a delayed work item,
retrying every second for up to a minute, registering nothing until
every sensor has answered.

It does not cover the boots where the ADSP never brings the sensors up
at all: on this phone that happens when its first run does not crash and
restart, and is not understood yet.

---
--- a/drivers/iio/common/qcom_smgr/qcom_smgr.c
+++ b/drivers/iio/common/qcom_smgr/qcom_smgr.c
@@ -39,6 +39,8 @@
 	struct qmi_handle sns_smgr_hdl;
 	struct sockaddr_qrtr sns_smgr_info;
 	struct work_struct sns_smgr_work;
+	struct delayed_work enum_work;
+	unsigned int enum_tries;
 
 	u8 sensor_count;
 	struct qcom_smgr_sensor *sensors;
@@ -136,7 +138,7 @@
 
 	/* Check the response */
 	if (resp.result) {
-		dev_err(smgr->dev, "Available sensors request failed: 0x%x\n",
+		dev_dbg(smgr->dev, "Available sensors request failed: 0x%x\n",
 			resp.result);
 		return -EREMOTEIO;
 	}
@@ -193,7 +195,7 @@
 
 	/* Check the response */
 	if (resp.result) {
-		dev_err(smgr->dev, "Single sensor info request failed: 0x%x\n",
+		dev_dbg(smgr->dev, "Single sensor info request failed: 0x%x\n",
 			resp.result);
 		return -EREMOTEIO;
 	}
@@ -701,40 +703,27 @@
 };
 EXPORT_SYMBOL_GPL(qcom_smgr_iio_ext_info);
 
-static int qcom_smgr_probe(struct qrtr_device *qdev)
-{
-	struct qcom_smgr *smgr;
-	int i, j;
-	int ret;
+#define SMGR_ENUM_TRIES		60
+#define SMGR_ENUM_RETRY		msecs_to_jiffies(1000)
 
-	smgr = devm_kzalloc(&qdev->dev, sizeof(*smgr), GFP_KERNEL);
-	if (!smgr)
-		return -ENOMEM;
-
-	smgr->dev = &qdev->dev;
-
-	smgr->sns_smgr_info.sq_family = AF_QIPCRTR;
-	smgr->sns_smgr_info.sq_node = qdev->node;
-	smgr->sns_smgr_info.sq_port = qdev->port;
-
-	dev_set_drvdata(&qdev->dev, smgr);
+/*
+ * Ask for every sensor and the details of each, registering nothing, so a
+ * failure part way leaves nothing behind to undo and the whole can be retried.
+ * What a failed attempt allocated stays with the device until it unbinds,
+ * bounded by SMGR_ENUM_TRIES.
+ */
+static int qcom_smgr_get_sensors(struct qcom_smgr *smgr)
+{
+	int i, j, ret;
 
-	ret = qmi_handle_init(&smgr->sns_smgr_hdl,
-			      SNS_SMGR_SINGLE_SENSOR_INFO_RESP_MAX_LEN, NULL,
-			      qcom_smgr_msg_handlers);
-	if (ret < 0) {
-		dev_err(smgr->dev,
-			"Failed to initialize sensor manager handle: %d\n",
-			ret);
-		return ret;
+	if (smgr->sensors) {
+		devm_kfree(smgr->dev, smgr->sensors);
+		smgr->sensors = NULL;
 	}
 
 	ret = qcom_smgr_request_all_sensor_info(smgr, &smgr->sensors);
-	if (ret < 0) {
-		dev_err(smgr->dev, "Failed to get available sensors: %pe\n",
-			ERR_PTR(ret));
+	if (ret < 0)
 		return ret;
-	}
 	smgr->sensor_count = ret;
 
 	/* Get primary and secondary sensors from each sensor ID */
@@ -743,10 +732,9 @@
 
 		/*
 		 * The service lists some IDs more than once. Registering an ID
-		 * twice collides in sysfs, and while the error is not fatal -
-		 * the return below is deliberately not checked - it costs a
-		 * round trip to the DSP per repeat and leaves a backtrace in
-		 * every boot log.
+		 * twice collides in sysfs, and it costs a round trip to the DSP
+		 * per repeat, so ask once and leave the repeat with no data
+		 * types, which probe skips.
 		 */
 		for (j = 0; j < i; j++) {
 			if (smgr->sensors[j].id == smgr->sensors[i].id) {
@@ -760,25 +748,95 @@
 		ret = qcom_smgr_request_single_sensor_info(smgr,
 							   &smgr->sensors[i]);
 		if (ret < 0) {
-			dev_err(smgr->dev,
-				"Failed to get sensors from ID 0x%02x: %pe\n",
+			dev_dbg(smgr->dev, "sensor 0x%02x not ready: %pe\n",
 				smgr->sensors[i].id, ERR_PTR(ret));
 			return ret;
 		}
 
-		for (j = 0; j < smgr->sensors[i].data_type_count; j++) {
-			/* Default to maximum sample rate */
+		/* Default to maximum sample rate */
+		for (j = 0; j < smgr->sensors[i].data_type_count; j++)
 			smgr->sensors[i].data_types[j].cur_sample_rate =
 				smgr->sensors[i].data_types[j].max_sample_rate;
+	}
+
+	return 0;
+}
+
+/*
+ * The sensor manager service appears before the DSP has brought every sensor
+ * up: asked too early, it times out or refuses (0x701 for the accelerometer).
+ * To bring them up it reads the sensor registry, which qcom_sns_reg serves,
+ * and probe runs where waiting in it held that up: retrying inside probe only
+ * ran out its time, and the DSP's registry requests arrived the moment it
+ * gave up. So enumerate here instead, every second for up to a minute.
+ */
+static void qcom_smgr_enum_work(struct work_struct *work)
+{
+	struct qcom_smgr *smgr = container_of(to_delayed_work(work),
+					      struct qcom_smgr, enum_work);
+	int i, j, ret;
+
+	ret = qcom_smgr_get_sensors(smgr);
+	if ((ret == -ETIMEDOUT || ret == -EREMOTEIO) &&
+	    ++smgr->enum_tries < SMGR_ENUM_TRIES) {
+		schedule_delayed_work(&smgr->enum_work, SMGR_ENUM_RETRY);
+		return;
+	}
+	if (ret < 0) {
+		dev_err(smgr->dev, "Failed to get sensors: %pe\n", ERR_PTR(ret));
+		return;
+	}
+	if (smgr->enum_tries)
+		dev_info(smgr->dev, "sensors ready after %u retries\n",
+			 smgr->enum_tries);
+
+	for (i = 0; i < smgr->sensor_count; i++) {
+		if (!smgr->sensors[i].data_type_count)
+			continue;	/* a repeated ID */
 
+		for (j = 0; j < smgr->sensors[i].data_type_count; j++)
 			dev_info(smgr->dev, "0x%02x,%d: %s %s\n",
-				smgr->sensors[i].id, j,
-				smgr->sensors[i].data_types[j].vendor,
-				smgr->sensors[i].data_types[j].name);
-		}
+				 smgr->sensors[i].id, j,
+				 smgr->sensors[i].data_types[j].vendor,
+				 smgr->sensors[i].data_types[j].name);
 
 		qcom_smgr_register_sensor(smgr, &smgr->sensors[i]);
 	}
+}
+
+static int qcom_smgr_probe(struct qrtr_device *qdev)
+{
+	struct qcom_smgr *smgr;
+	int i, j;
+	int ret;
+
+	smgr = devm_kzalloc(&qdev->dev, sizeof(*smgr), GFP_KERNEL);
+	if (!smgr)
+		return -ENOMEM;
+
+	smgr->dev = &qdev->dev;
+
+	smgr->sns_smgr_info.sq_family = AF_QIPCRTR;
+	smgr->sns_smgr_info.sq_node = qdev->node;
+	smgr->sns_smgr_info.sq_port = qdev->port;
+
+	dev_set_drvdata(&qdev->dev, smgr);
+
+	ret = qmi_handle_init(&smgr->sns_smgr_hdl,
+			      SNS_SMGR_SINGLE_SENSOR_INFO_RESP_MAX_LEN, NULL,
+			      qcom_smgr_msg_handlers);
+	if (ret < 0) {
+		dev_err(smgr->dev,
+			"Failed to initialize sensor manager handle: %d\n",
+			ret);
+		return ret;
+	}
+
+	/*
+	 * Enumerate from a work item, not here: see qcom_smgr_enum_work().
+	 */
+	INIT_DELAYED_WORK(&smgr->enum_work, qcom_smgr_enum_work);
+	schedule_delayed_work(&smgr->enum_work, 0);
 
 	return 0;
 }
@@ -787,6 +845,7 @@
 {
 	struct qcom_smgr *smgr = dev_get_drvdata(&qdev->dev);
 
+	cancel_delayed_work_sync(&smgr->enum_work);
 	qmi_handle_release(&smgr->sns_smgr_hdl);
 }
 
