+	/* K_DATA is an auto-incrementing window; K_ADDR selects its start. */
+	snd_soc_component_update_bits(comp, WCD9320_A_CDC_CLSH_K_ADDR,
+				      0x80, 0x00);
+	snd_soc_component_update_bits(comp, WCD9320_A_CDC_CLSH_K_ADDR,
+				      0x0f, 0x00);
+	for (i = 0; i < ARRAY_SIZE(k_data); i++)
+		snd_soc_component_write(comp, WCD9320_A_CDC_CLSH_K_DATA,
+					k_data[i]);
