+/*
+ * Class-H control for the WCD9320 (Taiko).
+ *
+ * The file this replaces was the WCD9335's, imported wholesale with the driver.
+ * Every register it touched was a 9335 address - all of them >= 0x400, past the
+ * end of a Taiko's map - so every write came back -EIO and 0054 disabled the
+ * whole thing with an early return. That left the headphone path running on
+ * reset defaults, which on this part means the buck, the NCP and the charge
+ * pump are all off and the PA has no supply.
+ *
+ * This is a port of the Taiko sequence from downstream's wcd9xxx-common.c
+ * against the WCD9320_A_CDC_CLSH_* block at 0x320 and the buck/NCP registers at
+ * 0x181/0x192. It is checked against docs/golden-reference/, captured from a
+ * working LineageOS stack on this phone with audio playing.
+ *
+ * Four registers deliberately do *not* match that reference. Downstream runs
+ * wcd9xxx_clsh_imped_config() using a headphone impedance measured by the MBHC
+ * block - its tinymix shows a real "HPHL Impedance" reading - and that scales
+ * IDLE_HPH_THSD, FCLKONLY_HPH_THSD and both I_PA_FACT_HPH registers. We have no
+ * MBHC, so we use downstream's base values, which assume a 16 ohm load per
+ * channel, exactly as its own comment says. Do not "fix" these to the golden
+ * numbers; those encode one particular pair of headphones.
+ */
+
 #include <linux/kernel.h>
 #include <linux/delay.h>
