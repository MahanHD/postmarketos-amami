+	/* 16 ohm per channel; see the note at the top of this file. */
+	snd_soc_component_update_bits(comp, WCD9320_A_CDC_CLSH_IDLE_HPH_THSD,
+				      0x3f, 0x13);
+	snd_soc_component_update_bits(comp,
