+/*
+ * VBAT_SNS is only wired up on boards that pass a "vbat" io-channel; without
+ * it (and without a monitored-battery profile) we simply do not offer
+ * VOLTAGE_NOW/CAPACITY.
+ *
+ * The channel is looked up on first use rather than in probe() because the
+ * VADC is typically a module: an early read can land before it has loaded, and
+ * probing would have nothing to do but defer. A failed lookup is deliberately
+ * not cached so that a later read can still pick the channel up.
+ *
+ * This laziness is not what keeps USB alive on boards where this charger is the
+ * extcon provider - fw_devlink is settled in the device tree instead, see the
+ * comment on the io-channels property there.
+ */
+static int smbb_battery_voltage(struct smbb_charger *chg, int *uv)
+{
+	int rc;
+
+	if (!chg->vbat) {
+		struct iio_channel *ch;
+
+		mutex_lock(&chg->vbat_lock);
+		/* another reader may have got there while we waited */
+		if (!chg->vbat) {
+			ch = devm_iio_channel_get(chg->dev, "vbat");
+			if (!IS_ERR(ch))
+				chg->vbat = ch;
+		}
+		mutex_unlock(&chg->vbat_lock);
+
+		if (!chg->vbat)
+			return -ENODATA;
+	}
+
+	/* a successful read returns IIO_VAL_INT, not 0 */
+	rc = iio_read_channel_processed(chg->vbat, uv);
+
+	return rc < 0 ? rc : 0;
+}
+
+/*
+ * Capacity is read straight off the resting OCV curve, so it reads high while
+ * charging: the terminal voltage then sits above the cell's true open-circuit
+ * voltage. That is good enough to stop userspace believing the battery is flat,
+ * which is the point of reporting it at all.
+ *
+ * ocv_table[0] is the only curve there is to pick - the profile carries a
+ * single 25 degC table and we do not read pack temperature - so index 0 rather
+ * than power_supply_find_ocv2cap_table() is deliberate.
+ */
+static int smbb_battery_capacity(struct smbb_charger *chg, int *cap)
+{
+	int uv, rc;
+
+	if (!chg->batt_info || !chg->batt_info->ocv_table[0])
+		return -ENODATA;
+
+	rc = smbb_battery_voltage(chg, &uv);
+	if (rc)
+		return rc;
+
+	*cap = power_supply_ocv2cap_simple(chg->batt_info->ocv_table[0],
+					   chg->batt_info->ocv_table_size[0],
+					   uv);
+
+	return 0;
+}
