+		return qcom_vadc_scale_batt_therm(calib_graph, prescale,
+						  absolute, adc_code,
+						  result);
 	case SCALE_PMIC_THERM:
 		return qcom_vadc_scale_die_temp(calib_graph, prescale,
 						absolute, adc_code,
--- a/drivers/iio/adc/qcom-spmi-vadc.c	2026-10-16 12:25:55.889996024 +0400
+++ b/drivers/iio/adc/qcom-spmi-vadc.c	2026-10-16 12:26:38.657354866 +0400
@@ -609,7 +609,14 @@
 	VADC_CHAN_NO_SCALE(P_MUX15_1_3, 1)
 	VADC_CHAN_NO_SCALE(P_MUX16_1_3, 1)
 
-	VADC_CHAN_NO_SCALE(LR_MUX1_BAT_THERM, 0)
+	/*
+	 * The battery thermistor. Left unscaled, it turned up as
+	 * in_voltage48_raw only, and nothing could read a battery temperature.
+	 * Downstream scales it with its battery-thermistor table, and the
+	 * generic 100k pullup curve is not a substitute: on the Xperia Z1
+	 * Compact it read 40.7C where that table, stock's, reads 43.3C.
+	 */
+	VADC_CHAN_TEMP(LR_MUX1_BAT_THERM, 0, SCALE_BATT_THERM)
 	VADC_CHAN_VOLT(LR_MUX2_BAT_ID, 0, SCALE_DEFAULT)
 	VADC_CHAN_NO_SCALE(LR_MUX3_XO_THERM, 0)
 	VADC_CHAN_NO_SCALE(LR_MUX4_AMUX_THM1, 0)
