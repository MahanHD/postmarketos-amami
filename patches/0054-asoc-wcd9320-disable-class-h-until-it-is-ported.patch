--- a/sound/soc/codecs/wcd-clsh.c
+++ b/sound/soc/codecs/wcd-clsh.c
@@ -793,6 +793,23 @@
 		u8 clsh_event, u8 req_state,
 		int int_mode)
 {
+	/*
+	 * Class-H is disabled on the WCD9320 for now.
+	 *
+	 * Every register address in this file is a WCD9335 one - all twenty are
+	 * >= 0x400, and the WCD9320's map ends at 0x400 - because upstream
+	 * shares this file between the two codecs and only ever had the WCD9335
+	 * right. On a Taiko each write is out of range, comes back -EIO, and
+	 * leaves the headphone path half-configured.
+	 *
+	 * Class-H is a power optimisation, not a prerequisite for sound: the
+	 * headphone PA still runs in its reset default. Returning early keeps
+	 * the path consistent instead of writing at random, and makes it
+	 * testable whether anything else is missing. Rewriting this against the
+	 * WCD9320_A_CDC_CLSH_* block at 0x320 is the real fix.
+	 */
+	return;
+
 	u8 old_state, new_state;
 	char msg0[128], msg1[128];
 
