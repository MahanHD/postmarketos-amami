+/*
+ * A contrast measure for autofocus, from the centre half of the frame in each
+ * direction. In CSI-2 packed RAW10 the first four bytes of every five are the
+ * high bits of four pixels, which alternate between two colours, so bytes 0
+ * and 2, and 1 and 3, are neighbours of the same colour.
+ */
+void SwStatsCpu::accumulateSharpness(unsigned int y, const uint8_t *line,
+				     SwIspStats &stats)
+{
+	const unsigned int top = static_cast<unsigned int>(window_.y);
+	const unsigned int left = static_cast<unsigned int>(window_.x);
+
+	if (y < top + window_.height / 4 || y >= top + window_.height * 3 / 4)
+		return;
+
+	const unsigned int start = (left + window_.width / 4) / 4 * 5;
+	const unsigned int end = (left + window_.width * 3 / 4) / 4 * 5;
+	uint64_t sharpness = 0;
+	uint64_t level = 0;
+
+	for (unsigned int x = start; x < end; x += 5) {
+		const int a = line[x], b = line[x + 1], c = line[x + 2], d = line[x + 3];
+
+		sharpness += std::abs(a - c) + std::abs(b - d);
+		level += a + b + c + d;
+	}
+
+	stats.sharpness += sharpness;
+	stats.sharpnessLevel += level;
+}
