+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast detection autofocus
+ *
+ * Sweep the lens from infinity towards macro in coarse steps until the
+ * sharpness has clearly passed its peak, sweep the area around the best
+ * position in finer steps, then hold. While holding, rescan when the sharpness
+ * moves well away from what it was at the start of the hold.
+ */
+
+#include "af.h"
+
+#include <algorithm>
+
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/base/log.h>
+
+#include "simple/ipa_context.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPASoftAf)
+
+namespace ipa::soft::algorithms {
+
+/* A coarse sweep stops this far below its best */
+static constexpr double kPeakDrop = 0.85;
+/* While holding, rescan after this many samples this far from the reference */
+static constexpr double kDrift = 0.7;
+static constexpr unsigned int kDriftSamples = 3;
+/* While holding, resend the position this often (in statistics samples) */
+static constexpr unsigned int kRefreshSamples = 5;
+
+int Af::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	infinity_ = tuningData["infinity"].get<int32_t>(0);
+	macro_ = tuningData["macro"].get<int32_t>(0);
+	step_ = std::max(tuningData["step"].get<int32_t>(32), 4);
+
+	return 0;
+}
+
+int Af::configure(IPAContext &context, const IPAConfigInfo &configInfo)
+{
+	context.activeState.af = {};
+	samples_.clear();
+	state_ = State::Idle;
+
+	const auto it = configInfo.lensControls.find(V4L2_CID_FOCUS_ABSOLUTE);
+	enabled_ = it != configInfo.lensControls.end();
+	if (!enabled_)
+		return 0;
+
+	const int32_t min = it->second.min().get<int32_t>();
+	const int32_t max = it->second.max().get<int32_t>();
+
+	lo_ = infinity_ ? std::max(min, infinity_ - 2 * step_) : min;
+	hi_ = macro_ ? std::min(max, macro_ + step_) : max;
+	if (hi_ <= lo_) {
+		lo_ = min;
+		hi_ = max;
+	}
+
+	LOG(IPASoftAf, Debug) << "Scanning " << lo_ << "-" << hi_;
+
+	return 0;
+}
+
+void Af::moveTo(IPAContext &context, int32_t position)
+{
+	position_ = std::clamp(position, lo_, hi_);
+	context.activeState.af.position = position_;
+	context.activeState.af.update = true;
+}
+
+const Af::Sample &Af::best() const
+{
+	return *std::max_element(samples_.begin(), samples_.end(),
+				 [](const Sample &a, const Sample &b) {
+					 return a.sharpness < b.sharpness;
+				 });
+}
+
+void Af::process(IPAContext &context,
+		 [[maybe_unused]] const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 [[maybe_unused]] ControlList &metadata)
+{
+	if (!enabled_ || !stats->valid)
+		return;
+
+	const double sharpness = static_cast<double>(stats->sharpness) /
+				 std::max<uint64_t>(stats->sharpnessLevel, 1);
+
+	switch (state_) {
+	case State::Idle:
+		samples_.clear();
+		state_ = State::Coarse;
+		moveTo(context, lo_);
+		break;
+
+	case State::Coarse: {
+		samples_.push_back({ position_, sharpness });
+		const Sample &peak = best();
+		const bool past = samples_.size() >= 3 &&
+				  samples_.back().position > peak.position + step_ &&
+				  sharpness < kPeakDrop * peak.sharpness;
+
+		if (!past && position_ < hi_) {
+			moveTo(context, position_ + step_);
+			break;
+		}
+
+		const int32_t centre = peak.position;
+		samples_.clear();
+		fineEnd_ = std::min(centre + step_, hi_);
+		state_ = State::Fine;
+		moveTo(context, centre - step_);
+		break;
+	}
+
+	case State::Fine:
+		samples_.push_back({ position_, sharpness });
+		if (position_ < fineEnd_) {
+			moveTo(context, position_ + step_ / 2);
+			break;
+		}
+
+		LOG(IPASoftAf, Debug) << "Focused at " << best().position;
+		state_ = State::Hold;
+		reference_ = 0;
+		drift_ = 0;
+		holdCount_ = 0;
+		moveTo(context, best().position);
+		break;
+
+	case State::Hold:
+		/* The first sample at the chosen position is the reference */
+		if (!reference_) {
+			reference_ = sharpness;
+			break;
+		}
+
+		if (sharpness < kDrift * reference_ || sharpness * kDrift > reference_)
+			drift_++;
+		else
+			drift_ = 0;
+
+		if (drift_ >= kDriftSamples) {
+			state_ = State::Idle;
+			break;
+		}
+
+		/* Keep the lens powered: it switches off when left alone */
+		if (++holdCount_ % kRefreshSamples == 0)
+			moveTo(context, position_);
+		break;
+	}
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
