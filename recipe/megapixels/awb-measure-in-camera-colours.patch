 }
 
+/*
+ * Take an average colour of the shader's output, 0 to 255 per channel, back
+ * to the camera RGB it came from, before white balance: undo the gamma, the
+ * colour matrix and the gains, in that order. Averaging after the gamma is
+ * not the same as before it, but near grey, where white balance settles, the
+ * difference is small.
+ */
+void
+gles2_debayer_unprocess(GLES2Debayer *self, const float rgb[3], float camera[3])
+{
+        float linear[3];
+        for (int i = 0; i < 3; i++) {
+                linear[i] = powf(fmaxf(rgb[i], 0.0f) / 255.0f, self->gamma);
+        }
+
+        if (!self->forward_matrix[0]) {
+                /* The shader applied no matrix and no gains */
+                for (int i = 0; i < 3; i++) {
+                        camera[i] = linear[i];
+                }
+                return;
+        }
+
+        float xyzd65[9];
+        float tosrgb[9];
+        float fromsrgb[9];
+        multiply_matrices(XYZD50_to_D65, self->forward_matrix, xyzd65);
+        multiply_matrices(XYZD65_to_sRGB, xyzd65, tosrgb);
+        invert_matrix(tosrgb, fromsrgb);
+
+        for (int i = 0; i < 3; i++) {
+                camera[i] = fromsrgb[i * 3 + 0] * linear[0] +
+                            fromsrgb[i * 3 + 1] * linear[1] +
+                            fromsrgb[i * 3 + 2] * linear[2];
+        }
+        camera[0] /= self->red;
+        camera[2] /= self->blue;
+}
+
 void
 gles2_debayer_configure(GLES2Debayer *self,
                         const uint32_t dst_width,
@@ -256,6 +299,7 @@
                         gamma = g;
                 }
         }
+        self->gamma = gamma;
         glUniform1f(self->uniform_inv_gamma, 1.0f / gamma);
         check_gl();
 
