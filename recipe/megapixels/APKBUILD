# Contributor: Martijn Braam <martijn@brixit.nl>
# Maintainer: Oliver Smith <ollieparanoid@postmarketos.org>
# Alpine 3.24 community/megapixels with colour fixes for the Xperia Z1 Compact
pkgname=megapixels
pkgver=2.1.0
pkgrel=13
pkgdesc="GTK+4 camera app for mobile devices"
url="https://gitlab.com/megapixels-org/Megapixels"
# s390x: doubt anyone would use a mainframe to take photosj
arch="all !s390x"
license="GPL-3.0-only"
# Required by postprocess.sh
# depends="cmd:dcraw_emu cmd:convert cmd:exiftool"
depends="libraw-tools imagemagick exiftool flock libdng>=0.2.2-r1 libmegapixels>=0.2.3-r2"
makedepends="
	feedbackd-dev
	glib-dev
	gperf
	gtk4.0-dev
	libdng-dev
	libmegapixels-dev
	libxrandr-dev
	meson
	pulseaudio-dev
	tiff-dev>=4.6.0t
	zbar-dev
	"
source="https://gitlab.com/megapixels-org/Megapixels/-/archive/$pkgver/Megapixels-$pkgver.tar.bz2
	dcp-search-each-path.patch
	preview-colour-order.patch
	awb-stats-in-srgb.patch
	clip-after-white-balance.patch
	thumbnail-without-a-free-preview.patch
	photo-keeps-white-balance.patch
	black-level-from-the-config.patch
	preview-mode-nearest-the-preview-size.patch
	burst-of-the-frames-postprocess-reads.patch
	postprocess-one-photo-at-a-time.patch
	postprocess-sharpen-and-contrast-faster.patch
	zbar-rest-between-scans.patch
	awb-measure-in-camera-colours.patch
	"
options="!check" # There's no testsuite
builddir="$srcdir/Megapixels-$pkgver"

build() {
	abuild-meson . output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

